.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.user-header {
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  border-radius: 20rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.5);
}

.user-info {
  flex: 1;
  margin-left: 20rpx;
}

.user-name {
  font-size: 34rpx;
  font-weight: bold;
  color: white;
  display: block;
}

.user-id {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  display: block;
}

.user-points {
  background: rgba(255,255,255,0.2);
  padding: 15rpx 20rpx;
  border-radius: 12rpx;
  text-align: center;
}

.points-value {
  font-size: 36rpx;
  font-weight: bold;
  color: white;
  display: block;
}

.points-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.8);
}

.order-stats {
  background: white;
  border-radius: 16rpx;
  padding: 20rpx;
  display: flex;
  justify-content: space-around;
  margin-bottom: 20rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #FF6B6B;
  display: block;
}

.stat-label {
  font-size: 24rpx;
  color: #666;
  display: block;
}

.stat-divider {
  width: 1rpx;
  background: #f0f0f0;
}

.menu-list {
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 25rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.menu-label {
  flex: 1;
  font-size: 30rpx;
}

.menu-badge {
  background: #FF6B6B;
  color: white;
  font-size: 22rpx;
  padding: 5rpx 15rpx;
  border-radius: 20rpx;
  margin-right: 15rpx;
}

.menu-arrow {
  font-size: 28rpx;
  color: #999;
}

.admin-entry {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-radius: 16rpx;
  padding: 25rpx;
  margin-top: 20rpx;
}

.admin-entry-icon {
  font-size: 36rpx;
  margin-right: 15rpx;
}

.admin-entry-text {
  font-size: 30rpx;
  color: white;
  font-weight: bold;
}

.footer {
  text-align: center;
  padding: 40rpx 0;
}

.footer-text {
  font-size: 24rpx;
  color: #999;
}
