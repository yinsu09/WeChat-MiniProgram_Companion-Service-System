.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 20rpx;
}

.order-info {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.info-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.service-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.order-status {
  font-size: 26rpx;
  color: #4CAF50;
  background: #E8F5E9;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.info-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.label {
  font-size: 28rpx;
  color: #999;
}

.value {
  font-size: 28rpx;
  color: #333;
}

.rating-section {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.rating-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.rating-stars {
  display: flex;
  justify-content: center;
  margin-bottom: 10rpx;
}

.star-wrapper {
  display: flex;
  position: relative;
  width: 44rpx;
  height: 44rpx;
  margin: 0 4rpx;
}

.star-left,
.star-right {
  position: absolute;
  width: 22rpx;
  height: 44rpx;
  overflow: hidden;
  font-size: 44rpx;
  line-height: 44rpx;
}

.star-left {
  left: 0;
}

.star-right {
  right: 0;
}

.star-left::before,
.star-right::before {
  position: absolute;
  color: #ddd;
}

.star-left.full::before,
.star-right.full::before {
  content: '★';
  color: #FF6B6B;
}

.star-left.half::before,
.star-right.half::before {
  content: '★';
  color: #FF6B6B;
}

.star-left.gray::before {
  content: '★';
  color: #ddd;
}

.star-right.gray::before {
  content: '★';
  color: #ddd;
}

.rating-value {
  text-align: center;
  font-size: 28rpx;
  color: #FF6B6B;
  font-weight: bold;
}

.rating-hint {
  text-align: center;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 20rpx;
  margin-top: -10rpx;
}

.tags-section {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.tags-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.tags-grid {
  display: flex;
  flex-wrap: wrap;
}

.tag-item {
  font-size: 26rpx;
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid #ddd;
  color: #666;
}

.tag-item.selected.positive {
  background: #E8F5E9;
  border-color: #4CAF50;
  color: #4CAF50;
}

.tag-item.selected.negative {
  background: #FFEBEE;
  border-color: #E91E63;
  color: #E91E63;
}

.comment-section {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.comment-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.comment-input {
  width: 100%;
  height: 160rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.text-count {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
}

.submit-btn {
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  color: white;
  text-align: center;
  padding: 28rpx 0;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 40rpx;
}

.submit-btn.disabled {
  background: #ccc;
  color: #fff;
}