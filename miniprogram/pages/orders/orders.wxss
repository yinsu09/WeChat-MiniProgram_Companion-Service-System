.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.tabs {
  display: flex;
  background: white;
  border-radius: 12rpx;
  padding: 10rpx;
  margin-bottom: 20rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  font-size: 28rpx;
  color: #666;
  border-radius: 8rpx;
}

.tab.active {
  background: #FF6B6B;
  color: white;
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.order-card {
  background: white;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
  padding-bottom: 15rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.order-no {
  font-size: 24rpx;
  color: #999;
}

.order-status {
  font-size: 26rpx;
  font-weight: bold;
}

.order-content {
  margin-bottom: 15rpx;
}

.service-name {
  font-size: 30rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 10rpx;
}

.custom-req {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 10rpx;
  line-height: 1.4;
}

.service-info {
  display: flex;
  gap: 30rpx;
}

.service-date, .service-provider {
  font-size: 24rpx;
  color: #666;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 15rpx;
  border-top: 1rpx solid #f0f0f0;
}

.order-price {
  font-size: 32rpx;
  font-weight: bold;
  color: #FF6B6B;
}

.order-actions {
  display: flex;
  gap: 15rpx;
}

.action-btn {
  padding: 10rpx 20rpx;
  border: 1rpx solid #ccc;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.action-btn.primary {
  background: #FF6B6B;
  color: white;
  border-color: #FF6B6B;
}

.action-btn.warning {
  border-color: #FFD700;
  color: #FFD700;
}

.action-btn.disabled {
  background: #f0f0f0;
  color: #999;
  border-color: #ddd;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.refund-hint {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}

.card-progress {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #FF6B6B;
}
