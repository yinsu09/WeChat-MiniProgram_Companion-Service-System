<view class="admin-container">
  <view class="header">
    <text class="header-title">退费管理</text>
    <view class="header-right">
      <view class="rules-btn" bindtap="goToRefundRules">退费规则</view>
    </view>
  </view>

  <view class="stats-section">
    <view class="stats-card">
      <view class="stat-item">
        <text class="stat-value">{{stats.pendingCount || 0}}</text>
        <text class="stat-label">待处理</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">{{stats.canceledCount || 0}}</text>
        <text class="stat-label">已取消</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">¥{{stats.totalRefunded || 0}}</text>
        <text class="stat-label">退费总额</text>
      </view>
    </view>
  </view>

  <view class="filter-section">
    <view class="filter-tabs">
      <view 
        wx:for="{{statusOptions}}" 
        wx:key="value"
        class="filter-tab {{currentStatus === item.value ? 'active' : ''}}"
        bindtap="filterByStatus"
        data-status="{{item.value}}"
      >{{item.label}}</view>
    </view>
  </view>

  <view class="refund-list">
    <view 
      wx:for="{{refunds}}" 
      wx:key="id" 
      class="refund-card"
      bindtap="goToRefundDetail"
      data-id="{{item.id}}"
    >
      <view class="refund-header">
        <text class="refund-no">订单号: {{item.order_no}}</text>
        <view class="status-badge {{item.statusClass}}">{{item.statusText}}</view>
      </view>
      <view class="refund-content">
        <view class="order-info">
          <text class="service-name">{{item.service_name || '服务'}}</text>
          <text class="user-name">用户: {{item.user_name || '未知'}}</text>
        </view>
      </view>
      <view class="refund-footer">
        <view class="amount-section">
          <view class="amount-item">
            <text class="amount-label">订单金额:</text>
            <text class="amount-value">¥{{item.total_price || 0}}</text>
          </view>
          <view class="amount-item">
            <text class="amount-label refund">应退金额:</text>
            <text class="amount-value">¥{{item.amount || 0}}</text>
          </view>
        </view>
        <view class="action-btns" wx:if="{{item.status == 6}}">
          <view class="action-btn reject-btn" catchtap="handleReject" data-id="{{item.id}}">拒绝</view>
          <view class="action-btn approve-btn" catchtap="handleApprove" data-id="{{item.id}}">同意</view>
        </view>
      </view>
      <view class="reason-section" wx:if="{{item.reason}}">
        <text class="reason-label">退款原因:</text>
        <text class="reason-text">{{item.reason}}</text>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:if="{{refunds.length === 0}}">
    <text class="empty-icon">💰</text>
    <text class="empty-text">暂无退费申请</text>
  </view>
</view>