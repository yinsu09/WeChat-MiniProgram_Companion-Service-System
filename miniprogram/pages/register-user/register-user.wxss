.register-container {
  min-height: 100vh;
  background: #f5f5f5;
}

.user-register .header {
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 30rpx;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 40rpx;
  color: white;
}

.page-title {
  font-size: 34rpx;
  font-weight: bold;
  color: white;
}

.placeholder {
  width: 60rpx;
}

.register-form {
  padding: 40rpx 30rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 10rpx;
  display: block;
}

.form-input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #eee;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  background: white;
}

.code-row {
  display: flex;
  gap: 20rpx;
}

.code-input {
  flex: 1;
}

.get-code-btn {
  width: 180rpx;
  height: 80rpx;
  background: #FF6B6B;
  color: white;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
}

.agreement {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  padding: 20rpx 0;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #ccc;
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 10rpx;
}

.checkbox.selected {
  background: #FF6B6B;
  border-color: #FF6B6B;
}

.checkbox-icon {
  font-size: 24rpx;
  color: white;
}

.agreement-text {
  font-size: 24rpx;
  color: #999;
}

.agreement-link {
  font-size: 24rpx;
  color: #FF6B6B;
}

.register-btn {
  width: 100%;
  height: 88rpx;
  background: #FF6B6B;
  color: white;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
  margin-top: 40rpx;
}
