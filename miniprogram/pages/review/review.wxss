.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 100rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

.reviewed-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #E8F5E9;
  padding: 30rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.tip-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.tip-text {
  font-size: 28rpx;
  color: #4CAF50;
}

.review-form {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
}

.form-section {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #333;
  display: block;
}

.service-card {
  display: flex;
  background: #fafafa;
  padding: 20rpx;
  border-radius: 12rpx;
}

.service-image {
  width: 120rpx;
  height: 80rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
}

.service-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.service-name {
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.service-provider, .service-time {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 4rpx;
}

.rating-section {
  background: #fafafa;
  padding: 20rpx;
  border-radius: 12rpx;
}

.rating-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.rating-row:last-child {
  margin-bottom: 0;
}

.rating-label {
  font-size: 26rpx;
  width: 140rpx;
  color: #666;
}

.stars-container {
  display: flex;
  flex: 1;
  justify-content: center;
}

.star-wrapper {
  display: flex;
  width: 52rpx;
  height: 48rpx;
}

.star-left, .star-right {
  width: 26rpx;
  height: 48rpx;
  font-size: 44rpx;
  line-height: 48rpx;
  text-align: center;
  overflow: hidden;
}

.star-left {
  border-top-left-radius: 4rpx;
  border-bottom-left-radius: 4rpx;
}

.star-right {
  border-top-right-radius: 4rpx;
  border-bottom-right-radius: 4rpx;
}

.star-left.full, .star-right.full {
  color: #FFB800;
}

.star-left.half {
  background: linear-gradient(to right, #FFB800 50%, #ddd 50%);
  color: #ddd;
}

.star-left.half::before {
  content: '★';
  color: #FFB800;
  background: white;
  -webkit-mask: linear-gradient(to right, #000 50%, transparent 50%);
  mask: linear-gradient(to right, #000 50%, transparent 50%);
}

.star-left.empty, .star-right.empty {
  color: #ddd;
}

.rating-value {
  font-size: 26rpx;
  color: #FF6B6B;
  width: 100rpx;
  text-align: right;
  font-weight: bold;
}

.overall-rating {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #eee;
}

.overall-label {
  font-size: 28rpx;
  font-weight: bold;
  width: 140rpx;
}

.overall-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #FF6B6B;
  width: 100rpx;
  text-align: right;
}

.rating-hint {
  text-align: center;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #999;
}

.review-text {
  width: 100%;
  height: 200rpx;
  background: #fafafa;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.text-count {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.image-item image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.image-remove {
  position: absolute;
  top: -16rpx;
  right: -16rpx;
  width: 40rpx;
  height: 40rpx;
  background: #E53935;
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.image-add {
  width: 200rpx;
  height: 200rpx;
  background: #f5f5f5;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.add-icon {
  font-size: 60rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.add-text {
  font-size: 24rpx;
  color: #999;
}

.anonymous-section {
  margin-bottom: 40rpx;
}

.anonymous-toggle {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fafafa;
  padding: 20rpx;
  border-radius: 12rpx;
}

.anonymous-toggle text {
  font-size: 28rpx;
  color: #333;
}

.form-actions {
  padding-top: 20rpx;
}

.submit-btn {
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  color: white;
  padding: 28rpx;
  border-radius: 48rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 107, 0.3);
}

.review-history {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 20rpx;
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.history-title {
  font-size: 30rpx;
  font-weight: bold;
}

.history-stats {
  font-size: 24rpx;
  color: #999;
}

.history-summary {
  display: flex;
  background: #fafafa;
  padding: 24rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.summary-item {
  flex: 1;
  text-align: center;
}

.summary-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #FF6B6B;
  display: block;
  margin-bottom: 8rpx;
}

.summary-label {
  font-size: 24rpx;
  color: #666;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.history-item {
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.history-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.history-user {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.user-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 26rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 8rpx;
}

.user-rating {
  display: flex;
}

.mini-star {
  font-size: 24rpx;
  color: #ddd;
  margin-right: 4rpx;
}

.mini-star.active {
  color: #FFB800;
}

.history-time {
  font-size: 24rpx;
  color: #999;
}

.history-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  display: block;
  margin-bottom: 12rpx;
}

.history-images {
  display: flex;
  gap: 12rpx;
}

.history-images image {
  width: 150rpx;
  height: 150rpx;
  border-radius: 8rpx;
}