<view class="container" wx:if="{{item}}">
  <view class="card">
    <view class="row"><text class="label">订单号</text><text>{{item.order_no}}</text></view>
    <view class="row"><text class="label">服务</text><text>{{item.service_name}}</text></view>
    <view class="row"><text class="label">用户</text><text>{{item.user_name}}</text></view>
    <view class="row"><text class="label">类型</text><text>{{typeText}}</text></view>
    <view class="row"><text class="label">状态</text><text class="status">{{statusText}}</text></view>
    <view class="row"><text class="label">原因</text><text>{{item.reason}}</text></view>
    <view class="images" wx:if="{{item.images && item.images.length}}">
      <image wx:for="{{item.images}}" wx:key="*this" src="{{item}}" bindtap="previewImage" data-url="{{item}}" />
    </view>
  </view>

  <view class="card" wx:if="{{item.status === 0}}">
    <text class="section-title">处理</text>
    <view class="form-item">
      <text class="label">退款金额</text>
      <input type="digit" value="{{refundAmount}}" bindinput="onAmountInput" placeholder="留空则按规则计算" />
    </view>
    <view class="form-item">
      <text class="label">回复说明</text>
      <textarea value="{{adminReply}}" bindinput="onReplyInput" placeholder="处理说明" />
    </view>
    <view class="btns">
      <view class="btn approve" bindtap="approve">同意</view>
      <view class="btn reject" bindtap="reject">拒绝</view>
    </view>
  </view>

  <view class="card" wx:if="{{item.admin_reply}}">
    <text class="section-title">处理结果</text>
    <text>{{item.admin_reply}}</text>
    <text wx:if="{{item.refund_amount}}" class="amount">退款金额：¥{{item.refund_amount}}</text>
  </view>
</view>
