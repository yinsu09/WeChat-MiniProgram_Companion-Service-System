.container { padding: 24rpx; background: #f5f5f5; min-height: 100vh; }
.card { background: #fff; border-radius: 12rpx; padding: 24rpx; margin-bottom: 20rpx; }
.row { display: flex; margin-bottom: 16rpx; font-size: 28rpx; }
.label { width: 160rpx; color: #999; flex-shrink: 0; }
.status { color: #FF6B6B; }
.images { display: flex; gap: 12rpx; margin-top: 16rpx; }
.images image { width: 160rpx; height: 160rpx; border-radius: 8rpx; }
.section-title { font-size: 30rpx; font-weight: bold; display: block; margin-bottom: 16rpx; }
.form-item { margin-bottom: 20rpx; }
.form-item .label { display: block; margin-bottom: 8rpx; font-size: 26rpx; color: #666; }
.form-item input, .form-item textarea { background: #f8f8f8; padding: 16rpx; border-radius: 8rpx; font-size: 28rpx; width: 100%; box-sizing: border-box; }
.form-item textarea { min-height: 120rpx; }
.btns { display: flex; gap: 20rpx; }
.btn { flex: 1; text-align: center; padding: 24rpx; border-radius: 8rpx; color: #fff; }
.btn.approve { background: #4CAF50; }
.btn.reject { background: #999; }
.amount { display: block; margin-top: 12rpx; color: #FF6B6B; font-size: 28rpx; }
