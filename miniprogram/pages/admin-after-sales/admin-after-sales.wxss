.container { padding: 24rpx; background: #f5f5f5; min-height: 100vh; }
.filter-bar { display: flex; gap: 12rpx; margin-bottom: 20rpx; flex-wrap: wrap; }
.filter-tab { padding: 12rpx 24rpx; background: #fff; border-radius: 8rpx; font-size: 26rpx; }
.filter-tab.active { background: #FF6B6B; color: #fff; }
.item-card { background: #fff; border-radius: 12rpx; padding: 24rpx; margin-bottom: 16rpx; }
.item-header { display: flex; justify-content: space-between; margin-bottom: 8rpx; }
.order-no { font-size: 26rpx; color: #666; }
.status { font-size: 26rpx; color: #FF6B6B; }
.service-name { font-size: 30rpx; font-weight: bold; display: block; }
.meta { font-size: 24rpx; color: #999; display: block; margin: 8rpx 0; }
.reason { font-size: 28rpx; color: #333; display: block; }
.time { font-size: 22rpx; color: #bbb; margin-top: 8rpx; display: block; }
.empty { text-align: center; color: #999; padding: 80rpx; }
