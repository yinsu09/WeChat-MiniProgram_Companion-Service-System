<view class="search-container">
  <view class="search-header">
    <view class="search-box">
      <text class="search-icon">🔍</text>
      <input 
        class="search-input" 
        placeholder="搜索服务、服务人员" 
        value="{{keyword}}"
        bindinput="onInput"
        bindconfirm="onSearch"
        focus="{{true}}"
      />
      <text class="clear-btn" wx:if="{{keyword}}" bindtap="clearKeyword">✕</text>
    </view>
    <text class="cancel-btn" bindtap="goBack">取消</text>
  </view>

  <view class="filter-bar" wx:if="{{showFilter}}">
    <view class="filter-item" bindtap="toggleTypeFilter">
      <text class="filter-label">服务类型</text>
      <text class="filter-value">{{selectedTypeName || '全部'}}</text>
      <text class="filter-arrow">▼</text>
    </view>
    <view class="filter-item" bindtap="togglePriceFilter">
      <text class="filter-label">价格</text>
      <text class="filter-value">{{selectedPriceRange || '全部'}}</text>
      <text class="filter-arrow">▼</text>
    </view>
    <view class="filter-item" bindtap="toggleLevelFilter">
      <text class="filter-label">等级</text>
      <text class="filter-value">{{selectedLevelName || '全部'}}</text>
      <text class="filter-arrow">▼</text>
    </view>
  </view>

  <view class="type-filter-popup" wx:if="{{showTypeFilter}}">
    <view class="filter-options">
      <view class="filter-option {{selectedType === 0 ? 'active' : ''}}" bindtap="selectType" data-type="0">
        <text>全部类型</text>
      </view>
      <view 
        wx:for="{{serviceTypes}}" 
        wx:key="id" 
        class="filter-option {{selectedType === item.id ? 'active' : ''}}"
        bindtap="selectType"
        data-type="{{item.id}}"
      >
        <text>{{item.name}}</text>
      </view>
    </view>
  </view>

  <view class="price-filter-popup" wx:if="{{showPriceFilter}}">
    <view class="filter-options">
      <view class="filter-option {{selectedPrice === 0 ? 'active' : ''}}" bindtap="selectPrice" data-price="0">
        <text>全部价格</text>
      </view>
      <view class="filter-option {{selectedPrice === 1 ? 'active' : ''}}" bindtap="selectPrice" data-price="1">
        <text>0-50元</text>
      </view>
      <view class="filter-option {{selectedPrice === 2 ? 'active' : ''}}" bindtap="selectPrice" data-price="2">
        <text>50-100元</text>
      </view>
      <view class="filter-option {{selectedPrice === 3 ? 'active' : ''}}" bindtap="selectPrice" data-price="3">
        <text>100-200元</text>
      </view>
      <view class="filter-option {{selectedPrice === 4 ? 'active' : ''}}" bindtap="selectPrice" data-price="4">
        <text>200元以上</text>
      </view>
    </view>
  </view>

  <view class="level-filter-popup" wx:if="{{showLevelFilter}}">
    <view class="filter-options">
      <view class="filter-option {{selectedLevel === 0 ? 'active' : ''}}" bindtap="selectLevel" data-level="0">
        <text>全部等级</text>
      </view>
      <view class="filter-option {{selectedLevel === 1 ? 'active' : ''}}" bindtap="selectLevel" data-level="1">
        <text>金牌服务</text>
      </view>
      <view class="filter-option {{selectedLevel === 2 ? 'active' : ''}}" bindtap="selectLevel" data-level="2">
        <text>银牌服务</text>
      </view>
      <view class="filter-option {{selectedLevel === 3 ? 'active' : ''}}" bindtap="selectLevel" data-level="3">
        <text>铜牌服务</text>
      </view>
    </view>
  </view>

  <view class="history-section" wx:if="{{!hasSearched && searchHistory.length > 0}}">
    <view class="section-header">
      <text class="section-title">搜索历史</text>
      <text class="clear-history" bindtap="clearHistory">清空</text>
    </view>
    <view class="history-tags">
      <view 
        wx:for="{{searchHistory}}" 
        wx:key="*this" 
        class="history-tag"
        bindtap="searchByHistory"
        data-keyword="{{item}}"
      >
        <text>{{item}}</text>
      </view>
    </view>
  </view>

  <view class="hot-section" wx:if="{{!hasSearched}}">
    <view class="section-title">热门搜索</view>
    <view class="hot-tags">
      <view 
        wx:for="{{hotKeywords}}" 
        wx:key="*this" 
        class="hot-tag"
        bindtap="searchByHistory"
        data-keyword="{{item}}"
      >
        <text>{{item}}</text>
      </view>
    </view>
  </view>

  <view class="search-results" wx:if="{{hasSearched}}">
    <view class="result-tabs">
      <view class="tab {{activeTab === 'service' ? 'active' : ''}}" bindtap="switchTab" data-tab="service">
        <text>服务 ({{serviceResults.length}})</text>
      </view>
      <view class="tab {{activeTab === 'provider' ? 'active' : ''}}" bindtap="switchTab" data-tab="provider">
        <text>服务人员 ({{providerResults.length}})</text>
      </view>
    </view>

    <view class="service-results" wx:if="{{activeTab === 'service'}}">
      <view 
        wx:for="{{serviceResults}}" 
        wx:key="id" 
        class="service-result-item"
        bindtap="goToServiceDetail"
        data-service-id="{{item.id}}"
      >
        <image class="result-image" src="{{item.cover_image || 'https://via.placeholder.com/100'}}" />
        <view class="result-info">
          <text class="result-name">{{item.name}}</text>
          <text class="result-desc">{{item.description}}</text>
          <view class="result-meta">
            <text class="result-type">{{item.type_name}}</text>
            <text class="result-price">¥{{item.base_price}}/{{item.duration}}分钟</text>
          </view>
        </view>
      </view>
      <view class="no-result" wx:if="{{serviceResults.length === 0}}">
        <text>暂无相关服务</text>
      </view>
    </view>

    <view class="provider-results" wx:if="{{activeTab === 'provider'}}">
      <view 
        wx:for="{{providerResults}}" 
        wx:key="id" 
        class="provider-result-item"
        bindtap="goToProviderDetail"
        data-provider-id="{{item.id}}"
      >
        <image class="result-avatar" src="{{item.avatar_url || 'https://via.placeholder.com/60'}}" />
        <view class="result-info">
          <view class="result-name-row">
            <text class="result-name">{{item.nickname}}</text>
            <text class="result-status status-{{item.status}}">{{item.status_text}}</text>
          </view>
          <view class="result-level-box">
            <text class="result-level">{{item.level_name}}</text>
            <text class="result-stars">{{item.stars}}</text>
          </view>
          <text class="result-types">{{item.service_types}}</text>
          <text class="result-count">已服务{{item.service_count}}次</text>
        </view>
        <view class="result-right">
          <text class="result-rating">{{item.rating}}分</text>
          <text class="result-price">¥{{item.min_price}}起</text>
        </view>
      </view>
      <view class="no-result" wx:if="{{providerResults.length === 0}}">
        <text>暂无相关服务人员</text>
      </view>
    </view>
  </view>
</view>