.search-container {
  background-color: #f5f5f5;
  min-height: 100vh;
}

.search-header {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: white;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 30rpx;
  padding: 15rpx 20rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 15rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.clear-btn {
  font-size: 28rpx;
  color: #999;
  padding: 5rpx;
}

.cancel-btn {
  font-size: 28rpx;
  color: #FF6B6B;
  margin-left: 20rpx;
}

.filter-bar {
  display: flex;
  justify-content: space-around;
  padding: 15rpx 20rpx;
  background: white;
  border-bottom: 1rpx solid #eee;
}

.filter-item {
  display: flex;
  align-items: center;
}

.filter-label {
  font-size: 26rpx;
  color: #666;
}

.filter-value {
  font-size: 26rpx;
  color: #333;
  margin-left: 10rpx;
}

.filter-arrow {
  font-size: 20rpx;
  color: #999;
  margin-left: 5rpx;
}

.type-filter-popup,
.price-filter-popup,
.level-filter-popup {
  position: absolute;
  top: 180rpx;
  left: 0;
  right: 0;
  background: white;
  border-top: 1rpx solid #eee;
  z-index: 100;
}

.filter-options {
  padding: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.filter-option {
  padding: 15rpx 30rpx;
  background: #f5f5f5;
  border-radius: 20rpx;
  font-size: 26rpx;
}

.filter-option.active {
  background: #FF6B6B;
  color: white;
}

.history-section,
.hot-section {
  padding: 20rpx;
  background: white;
  margin-top: 20rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.clear-history {
  font-size: 26rpx;
  color: #999;
}

.history-tags,
.hot-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
  margin-top: 15rpx;
}

.history-tag,
.hot-tag {
  padding: 10rpx 20rpx;
  background: #f5f5f5;
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #666;
}

.hot-tag {
  background: rgba(255,107,107,0.1);
  color: #FF6B6B;
}

.search-results {
  padding: 20rpx;
}

.result-tabs {
  display: flex;
  background: white;
  border-radius: 20rpx;
  padding: 10rpx;
  margin-bottom: 20rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 15rpx;
  font-size: 28rpx;
  color: #666;
  border-radius: 15rpx;
}

.tab.active {
  background: #FF6B6B;
  color: white;
}

.service-results,
.provider-results {
  background: white;
  border-radius: 20rpx;
  padding: 20rpx;
}

.service-result-item,
.provider-result-item {
  display: flex;
  padding: 15rpx;
  border-bottom: 1rpx solid #eee;
}

.service-result-item:last-child,
.provider-result-item:last-child {
  border-bottom: none;
}

.result-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 10rpx;
  margin-right: 20rpx;
}

.result-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.result-info {
  flex: 1;
}

.result-name {
  font-size: 28rpx;
  font-weight: bold;
}

.result-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.result-status {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-weight: normal;
}

.result-status.status-idle {
  color: #52c41a;
  background: rgba(82, 196, 26, 0.12);
}

.result-status.status-busy {
  color: #fa8c16;
  background: rgba(250, 140, 22, 0.12);
}

.result-status.status-offline {
  color: #1890ff;
  background: rgba(24, 144, 255, 0.12);
}

.result-status.status-disabled {
  color: #999;
  background: rgba(0, 0, 0, 0.06);
}

.result-desc {
  font-size: 24rpx;
  color: #666;
  display: block;
  margin-top: 5rpx;
}

.result-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 10rpx;
}

.result-type {
  font-size: 22rpx;
  color: #FF6B6B;
  background: rgba(255,107,107,0.1);
  padding: 3rpx 10rpx;
  border-radius: 10rpx;
}

.result-price {
  font-size: 26rpx;
  color: #FF6B6B;
  font-weight: bold;
}

.result-level-box {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 5rpx;
}

.result-level {
  font-size: 22rpx;
  color: #FF6B6B;
  background: rgba(255,107,107,0.1);
  padding: 3rpx 10rpx;
  border-radius: 10rpx;
}

.result-stars {
  font-size: 20rpx;
}

.result-types {
  font-size: 24rpx;
  color: #666;
  display: block;
  margin-top: 5rpx;
}

.result-count {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-top: 5rpx;
}

.result-right {
  text-align: right;
}

.result-rating {
  font-size: 30rpx;
  color: #FF6B6B;
  font-weight: bold;
  display: block;
}

.no-result {
  text-align: center;
  padding: 50rpx;
  color: #999;
  font-size: 28rpx;
}