.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.filter-bar {
  display: flex;
  background: white;
  padding: 20rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}

.filter-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #666;
  position: relative;
}

.filter-tab.active {
  color: #4CAF50;
  font-weight: bold;
}

.filter-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background: #4CAF50;
  border-radius: 2rpx;
}

.order-list {
  padding: 20rpx;
}

.order-card {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.order-no {
  font-size: 26rpx;
  color: #999;
}

.order-status {
  font-size: 26rpx;
  font-weight: bold;
}

.order-content {
  margin-bottom: 20rpx;
}

.service-row, .user-row, .time-row, .address-row, .price-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.service-icon, .user-icon, .time-icon, .address-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.service-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.user-name {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

.user-phone {
  font-size: 32rpx;
  padding: 8rpx;
}

.time-text, .address-text {
  font-size: 26rpx;
  color: #666;
}

.price-row {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #f0f0f0;
}

.price-label {
  font-size: 26rpx;
  color: #666;
}

.price-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #FF6B6B;
}

.order-actions {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
  flex-wrap: wrap;
}

.completion-hint {
  width: 100%;
  font-size: 24rpx;
  color: #FF9800;
  margin-bottom: 8rpx;
  text-align: right;
}

.action-btn {
  padding: 14rpx 32rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
}

.action-btn.accept {
  background: #4CAF50;
  color: white;
}

.action-btn.reject {
  background: #f5f5f5;
  color: #666;
}

.action-btn.primary {
  background: #2196F3;
  color: white;
}

.action-btn.success {
  background: #4CAF50;
  color: white;
}

.action-btn.cancel {
  background: #f5f5f5;
  color: #E91E63;
}

.action-btn.disabled {
  background: #e0e0e0;
  color: #999;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.bottom-tip {
  text-align: center;
  padding: 20rpx;
  font-size: 24rpx;
  color: #999;
}

.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80%;
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
}

.modal-header {
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.modal-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.modal-body {
  padding: 30rpx;
}

.reject-reason, .cancel-reason {
  width: 100%;
  height: 200rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid #f5f5f5;
}

.modal-btn {
  flex: 1;
  text-align: center;
  padding: 30rpx;
  font-size: 28rpx;
}

.modal-btn.cancel {
  color: #666;
  border-right: 1rpx solid #f5f5f5;
}

.modal-btn.confirm {
  color: #4CAF50;
  font-weight: bold;
}