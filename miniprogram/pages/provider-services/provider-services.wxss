.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 20rpx;
}

.section {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

.service-types {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.type-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  border: 4rpx solid transparent;
}

.type-item.selected {
  background: #E8F5E9;
  border-color: #4CAF50;
}

.type-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.type-name {
  font-size: 26rpx;
  color: #333;
}

.type-check {
  font-size: 24rpx;
  color: #4CAF50;
  margin-top: 8rpx;
}

.time-grid {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.weekday-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #666;
}

.weekday-item.selected {
  background: #4CAF50;
  color: white;
}

.time-slots {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.time-slot {
  text-align: center;
  padding: 24rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #666;
}

.time-slot.selected {
  background: #4CAF50;
  color: white;
}

.form-item {
  margin-bottom: 20rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.save-btn {
  margin-top: 40rpx;
  background: linear-gradient(135deg, #4CAF50, #81C784);
  color: white;
  padding: 28rpx;
  border-radius: 48rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 16rpx rgba(76, 175, 80, 0.3);
}