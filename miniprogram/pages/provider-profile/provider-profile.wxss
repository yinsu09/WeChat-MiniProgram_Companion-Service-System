.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.profile-header {
  background: linear-gradient(135deg, #4CAF50, #81C784);
  padding: 50rpx 30rpx 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-section {
  position: relative;
  margin-bottom: 20rpx;
}

.avatar {
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, 0.5);
}

.avatar-edit {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 50rpx;
  height: 50rpx;
  background: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.provider-level {
  text-align: center;
}

.level-name {
  font-size: 28rpx;
  color: white;
  font-weight: bold;
  display: block;
  margin-bottom: 10rpx;
}

.level-stars {
  display: flex;
}

.star {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.4);
  margin: 0 4rpx;
}

.star.active {
  color: #FFD700;
}

.form-section {
  background: white;
  margin: -50rpx 20rpx 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  display: block;
  margin-bottom: 16rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.gender-group {
  display: flex;
  gap: 40rpx;
}

.gender-option {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #333;
}

.stats-section {
  background: white;
  margin: 0 20rpx 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
}

.stats-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 30rpx;
}

.stats-item {
  text-align: center;
  padding: 20rpx;
  background: #fafafa;
  border-radius: 12rpx;
}

.stats-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #4CAF50;
  display: block;
  margin-bottom: 8rpx;
}

.stats-label {
  font-size: 24rpx;
  color: #999;
}

.section-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
}

.work-status.working { color: #4CAF50; font-size: 26rpx; }
.work-status.resting { color: #FF9800; font-size: 26rpx; }

.work-mode-btns {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.mode-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
  font-size: 28rpx;
}

.mode-btn.active {
  background: #4CAF50;
  color: #fff;
}

.rest-item {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eee;
  font-size: 26rpx;
}

.rest-del { color: #f44336; }

.add-rest {
  text-align: center;
  padding: 20rpx;
  color: #4CAF50;
  font-size: 28rpx;
  margin-top: 12rpx;
}

.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.modal-content {
  background: #fff;
  width: 80%;
  border-radius: 16rpx;
  padding: 30rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 24rpx;
}

.modal-item {
  margin-bottom: 20rpx;
  font-size: 26rpx;
}

.picker-val {
  padding: 12rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  margin-top: 8rpx;
}

.modal-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.modal-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  border-radius: 8rpx;
}

.modal-btn.cancel { background: #f5f5f5; }
.modal-btn.confirm { background: #4CAF50; color: #fff; }

.save-btn {
  margin: 40rpx 20rpx;
  background: linear-gradient(135deg, #4CAF50, #81C784);
  color: white;
  padding: 28rpx;
  border-radius: 48rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 16rpx rgba(76, 175, 80, 0.3);
}