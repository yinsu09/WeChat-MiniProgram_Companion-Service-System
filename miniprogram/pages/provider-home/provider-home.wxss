.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.header {
  background: linear-gradient(135deg, #4CAF50, #81C784);
  padding: 30rpx;
  color: white;
  display: flex;
  justify-content: space-between;
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
}

.info-detail {
  display: flex;
  flex-direction: column;
}

.name {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.level-badge {
  display: inline-block;
  background: rgba(255, 255, 255, 0.3);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  width: fit-content;
}

.level-text {
  font-size: 22rpx;
}

.header-right {
  display: flex;
  align-items: center;
}

.income-card {
  background: rgba(255, 255, 255, 0.2);
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  text-align: center;
}

.income-label {
  font-size: 22rpx;
  opacity: 0.9;
  display: block;
  margin-bottom: 4rpx;
}

.income-value {
  font-size: 36rpx;
  font-weight: bold;
}

.stats-row {
  display: flex;
  background: white;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx 0;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

.stat-divider {
  width: 1rpx;
  background: #f0f0f0;
}

.menu-section {
  background: white;
  margin: 0 20rpx;
  border-radius: 16rpx;
  padding: 0 24rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon-wrap {
  position: relative;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  background: #FF6B6B;
  color: white;
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 20rpx;
  min-width: 32rpx;
  text-align: center;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.menu-arrow {
  font-size: 24rpx;
  color: #ccc;
}

.pending-order {
  margin: 20rpx;
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
}

.pending-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.pending-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.pending-count {
  font-size: 24rpx;
  color: #FF6B6B;
}

.pending-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fafafa;
  padding: 20rpx;
  border-radius: 12rpx;
}

.pending-info {
  display: flex;
  flex-direction: column;
}

.pending-service {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.pending-user, .pending-time {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 4rpx;
}

.action-arrow {
  font-size: 26rpx;
  color: #4CAF50;
}