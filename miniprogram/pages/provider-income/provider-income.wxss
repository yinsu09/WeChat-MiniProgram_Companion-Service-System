.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.income-header {
  background: linear-gradient(135deg, #4CAF50, #81C784);
  padding: 40rpx 30rpx;
  color: white;
}

.total-income {
  text-align: center;
  margin-bottom: 30rpx;
}

.income-label {
  font-size: 28rpx;
  opacity: 0.9;
  display: block;
  margin-bottom: 10rpx;
}

.income-value {
  font-size: 64rpx;
  font-weight: bold;
}

.income-tabs {
  display: flex;
  justify-content: center;
  gap: 40rpx;
}

.tab {
  font-size: 28rpx;
  opacity: 0.7;
  padding: 10rpx 20rpx;
}

.tab.active {
  opacity: 1;
  font-weight: bold;
  border-bottom: 4rpx solid white;
}

.stats-cards {
  display: flex;
  background: white;
  margin: -30rpx 20rpx 20rpx;
  border-radius: 16rpx;
  padding: 30rpx 0;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.stats-card {
  flex: 1;
  text-align: center;
  border-right: 1rpx solid #f0f0f0;
}

.stats-card:last-child {
  border-right: none;
}

.card-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #4CAF50;
  display: block;
  margin-bottom: 8rpx;
}

.card-label {
  font-size: 24rpx;
  color: #999;
}

.chart-section {
  background: white;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
}

.chart-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

.chart-placeholder {
  height: 280rpx;
}

.chart-bars {
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  height: 220rpx;
  padding: 0 10rpx;
}

.chart-bar-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  height: 100%;
  width: 60rpx;
}

.chart-bar {
  width: 40rpx;
  background: linear-gradient(to top, #4CAF50, #81C784);
  border-radius: 8rpx 8rpx 0 0;
  transition: height 0.3s;
}

.chart-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 10rpx;
}

.record-list {
  background: white;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
}

.record-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.record-item:last-child {
  border-bottom: none;
}

.record-info {
  display: flex;
  flex-direction: column;
}

.record-service {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.record-time {
  font-size: 22rpx;
  color: #999;
}

.record-amount {
  font-size: 32rpx;
  font-weight: bold;
  color: #4CAF50;
}