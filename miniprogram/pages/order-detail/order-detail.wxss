.container {
  padding-bottom: 160rpx;
  background-color: #f5f5f5;
}

.detail-header {
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-no {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.order-status {
  font-size: 30rpx;
  font-weight: bold;
  color: white;
}

.status-tip {
  margin-top: 15rpx;
  background: rgba(255, 255, 255, 0.2);
  padding: 12rpx 20rpx;
  border-radius: 8rpx;
}

.status-tip text {
  font-size: 24rpx;
  color: white;
}

.detail-section {
  background: white;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #333;
  display: block;
}

.service-card {
  display: flex;
  background: #fafafa;
  padding: 20rpx;
  border-radius: 12rpx;
}

.service-image {
  width: 150rpx;
  height: 100rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
}

.service-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.service-name {
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.service-desc {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.service-price {
  font-size: 30rpx;
  font-weight: bold;
  color: #FF6B6B;
}

.info-list {
  display: flex;
  flex-direction: column;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #666;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  display: flex;
  align-items: center;
}

.info-arrow {
  margin-left: 10rpx;
  font-size: 24rpx;
  color: #999;
}

.schedule-tip {
  font-size: 24rpx;
  color: #FF6B6B;
  margin-bottom: 16rpx;
  line-height: 1.5;
}

.section-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-header-row .section-title {
  margin-bottom: 0;
}

.edit-link {
  font-size: 26rpx;
  color: #FF6B6B;
}

.picker-value {
  color: #FF6B6B;
}

.footer-btn.disabled {
  opacity: 0.5;
}

.footer-btn.plain {
  background: #f5f5f5;
  color: #666;
}

.provider-info {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #fafafa;
  border-radius: 12rpx;
}

.view-detail {
  font-size: 24rpx;
  color: #FF6B6B;
  margin-right: 16rpx;
}

.provider-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.provider-detail {
  flex: 1;
}

.provider-name {
  font-size: 30rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 8rpx;
}

.provider-level {
  font-size: 24rpx;
  color: #FF6B6B;
  background: #fff5f5;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  display: inline-block;
}

.contact-btn {
  background: #FF6B6B;
  color: white;
  padding: 16rpx 32rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
}

.no-provider {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  background: #fafafa;
  border-radius: 12rpx;
}

.no-provider text:first-child {
  font-size: 28rpx;
  color: #999;
}

.assign-btn {
  background: #FF6B6B;
  color: white;
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
}

.service-content {
  background: #fafafa;
  padding: 20rpx;
  border-radius: 12rpx;
}

.service-content text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
}

.status-timeline {
  padding-left: 20rpx;
}

.timeline-item {
  display: flex;
  position: relative;
  padding-bottom: 30rpx;
}

.timeline-item:last-child {
  padding-bottom: 0;
}

.timeline-item::before {
  content: '';
  position: absolute;
  left: 9rpx;
  top: 24rpx;
  bottom: 0;
  width: 2rpx;
  background: #f0f0f0;
}

.timeline-item:first-child::before {
  display: none;
}

.timeline-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #ccc;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.timeline-content {
  flex: 1;
}

.timeline-status {
  font-size: 28rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 8rpx;
}

.timeline-time {
  font-size: 24rpx;
  color: #999;
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  padding: 20rpx;
  display: flex;
  gap: 20rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.08);
}

.footer-btn {
  flex: 1;
  padding: 24rpx;
  border-radius: 48rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: bold;
}

.footer-btn.primary {
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  color: white;
}

.footer-btn.secondary {
  background: #f5f5f5;
  color: #333;
}

.footer-btn.danger {
  background: #FFD700;
  color: #333;
}