.login-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  padding: 60rpx 40rpx;
}

.logo-section {
  text-align: center;
  padding: 100rpx 0 80rpx;
}

.logo-icon {
  font-size: 140rpx;
  display: block;
  margin-bottom: 20rpx;
}

.logo-title {
  font-size: 48rpx;
  font-weight: bold;
  color: white;
  display: block;
  margin-bottom: 10rpx;
}

.logo-subtitle {
  font-size: 28rpx;
  color: rgba(255,255,255,0.8);
}

.login-form {
  background: white;
  border-radius: 20rpx;
  padding: 40rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 10rpx;
  display: block;
}

.form-input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #eee;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

.code-row {
  display: flex;
  gap: 20rpx;
}

.code-input {
  flex: 1;
}

.get-code-btn {
  width: 180rpx;
  height: 80rpx;
  background: #FF6B6B;
  color: white;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
}

.role-select {
  margin: 30rpx 0;
}

.role-title {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}

.role-options {
  display: flex;
  gap: 20rpx;
}

.role-item {
  flex: 1;
  height: 100rpx;
  border: 2rpx solid #eee;
  border-radius: 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
}

.role-item.selected {
  border-color: #FF6B6B;
  background: #FFF5F5;
}

.role-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.role-name {
  font-size: 26rpx;
  color: #666;
}

.login-btn {
  width: 100%;
  height: 88rpx;
  background: #FF6B6B;
  color: white;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
  margin: 20rpx 0;
}

.register-link {
  text-align: center;
  padding: 20rpx 0;
}

.register-link text {
  font-size: 26rpx;
  color: #999;
}

.wechat-login {
  margin-top: 40rpx;
  text-align: center;
}

.wechat-title {
  font-size: 26rpx;
  color: rgba(255,255,255,0.7);
  display: block;
  margin-bottom: 20rpx;
}

.wechat-btn {
  display: inline-flex;
  align-items: center;
  gap: 15rpx;
  padding: 25rpx 60rpx;
  background: white;
  border-radius: 40rpx;
}

.wechat-icon {
  font-size: 40rpx;
}

.wechat-text {
  font-size: 30rpx;
  color: #333;
}
