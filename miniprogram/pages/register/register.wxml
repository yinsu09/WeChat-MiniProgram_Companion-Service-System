<view class="register-container">
  <view class="header">
    <view class="back-btn" bindtap="goBack">
      <text class="back-icon">←</text>
    </view>
    <text class="page-title">用户注册</text>
    <view class="placeholder"></view>
  </view>

  <view class="register-form">
    <view class="form-item">
      <text class="form-label">手机号</text>
      <input
        class="form-input"
        placeholder="请输入手机号"
        bindinput="onPhoneInput"
        value="{{phone}}"
      />
    </view>

    <view class="form-item">
      <text class="form-label">验证码</text>
      <view class="code-row">
        <input
          class="form-input code-input"
          placeholder="请输入验证码"
          bindinput="onCodeInput"
          value="{{code}}"
        />
        <view class="get-code-btn" bindtap="getCode">{{codeBtnText}}</view>
      </view>
    </view>

    <view class="form-item">
      <text class="form-label">密码</text>
      <input
        class="form-input"
        placeholder="请设置登录密码"
        type="password"
        bindinput="onPasswordInput"
        value="{{password}}"
      />
    </view>

    <view class="form-item">
      <text class="form-label">确认密码</text>
      <input
        class="form-input"
        placeholder="请再次输入密码"
        type="password"
        bindinput="onConfirmPasswordInput"
        value="{{confirmPassword}}"
      />
    </view>

    <view class="role-select">
      <text class="role-title">选择身份</text>
      <view class="role-options">
        <view
          class="role-item {{role === 1 ? 'selected' : ''}}"
          bindtap="selectRole"
          data-role="1"
        >
          <text class="role-icon">👤</text>
          <text class="role-name">普通用户</text>
        </view>
        <view
          class="role-item {{role === 2 ? 'selected' : ''}}"
          bindtap="selectRole"
          data-role="2"
        >
          <text class="role-icon">👩‍⚕️</text>
          <text class="role-name">服务人员</text>
        </view>
      </view>
    </view>

    <view class="register-btn" bindtap="handleRegister">注册</view>
  </view>
</view>