.container {
  padding: 24rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.profile-card {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  margin-right: 24rpx;
}

.profile-info {
  flex: 1;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.name {
  font-size: 36rpx;
  font-weight: bold;
}

.level {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
}

.stats-row {
  display: flex;
  gap: 24rpx;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.area {
  font-size: 24rpx;
  color: #999;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  display: block;
}

.stats-grid {
  display: flex;
  gap: 40rpx;
}

.stat-item {
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #FF6B6B;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

.review-item {
  border-top: 1rpx solid #eee;
  padding: 20rpx 0;
}

.review-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.review-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.review-meta {
  flex: 1;
}

.review-user {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
}

.review-service {
  font-size: 22rpx;
  color: #999;
}

.review-rating {
  font-size: 26rpx;
  color: #FF6B6B;
}

.review-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.review-images {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.review-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
}

.review-time {
  display: block;
  font-size: 22rpx;
  color: #bbb;
  margin-top: 8rpx;
}

.empty {
  text-align: center;
  color: #999;
  padding: 40rpx;
}

.loading {
  text-align: center;
  color: #999;
  padding: 80rpx;
}

.types {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-top: 8rpx;
}

.service-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-top: 1rpx solid #eee;
}

.service-cover {
  width: 100rpx;
  height: 100rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
}

.service-info {
  flex: 1;
}

.service-name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
}

.service-price {
  font-size: 24rpx;
  color: #FF6B6B;
  margin-top: 6rpx;
}

.arrow {
  font-size: 36rpx;
  color: #ccc;
}
