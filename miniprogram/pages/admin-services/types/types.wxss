.admin-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
}

.add-btn {
  background: rgba(255,255,255,0.2);
  padding: 15rpx 30rpx;
  border-radius: 25rpx;
  font-size: 28rpx;
}

.type-list {
  padding: 20rpx;
}

.type-card {
  display: flex;
  align-items: center;
  background: white;
  border-radius: 16rpx;
  padding: 25rpx;
  margin-bottom: 20rpx;
}

.type-icon {
  width: 80rpx;
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 20rpx;
}

.type-info {
  flex: 1;
}

.type-name {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.type-desc {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.type-meta {
  display: flex;
  gap: 20rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #999;
}

.type-status {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.status-badge {
  padding: 8rpx 20rpx;
  border-radius: 15rpx;
  font-size: 22rpx;
}

.status-badge.active {
  background: #52c41a;
  color: white;
}

.status-badge.inactive {
  background: #d9d9d9;
  color: white;
}

.toggle-btn {
  padding: 10rpx 25rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.toggle-btn.active {
  background: #ff4d4f;
  color: white;
}

.toggle-btn.inactive {
  background: #52c41a;
  color: white;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}