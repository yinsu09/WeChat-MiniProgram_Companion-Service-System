.admin-container {
  min-height: 100vh;
  background: #f5f5f5;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
}

.save-btn, .edit-btn {
  background: rgba(255,255,255,0.2);
  padding: 15rpx 30rpx;
  border-radius: 25rpx;
  font-size: 28rpx;
}

.form-section {
  padding: 20rpx;
}

.form-card {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.upload-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 30rpx;
}

.cover-image {
  width: 100%;
  height: 300rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.upload-btn {
  background: #f0f0f0;
  padding: 15rpx 30rpx;
  border-radius: 25rpx;
  font-size: 26rpx;
}

.gallery-section {
  margin-bottom: 25rpx;
}

.gallery-scroll {
  white-space: nowrap;
  margin-top: 16rpx;
}

.gallery-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
  display: inline-block;
}

.form-item {
  margin-bottom: 25rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 15rpx;
}

.form-input {
  width: 100%;
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.form-input:disabled {
  background: #fafafa;
  color: #999;
}

.form-textarea {
  width: 100%;
  height: 150rpx;
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.form-textarea:disabled {
  background: #fafafa;
  color: #999;
}

.form-value {
  font-size: 30rpx;
  color: #333;
}

.type-options {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.type-option {
  padding: 15rpx 25rpx;
  background: #f5f5f5;
  border-radius: 20rpx;
  font-size: 26rpx;
}

.type-option.active {
  background: #667eea;
  color: white;
}

.mode-options {
  display: flex;
  gap: 30rpx;
}

.mode-option {
  padding: 15rpx 40rpx;
  background: #f5f5f5;
  border-radius: 25rpx;
  font-size: 28rpx;
}

.mode-option.active {
  background: #667eea;
  color: white;
}

.count-input-wrap, .duration-input-wrap {
  display: flex;
  align-items: center;
}

.count-input, .duration-input {
  width: 200rpx;
}

.count-suffix, .duration-suffix {
  margin-left: 15rpx;
  font-size: 28rpx;
  color: #666;
}

.price-section {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-header {
  margin-bottom: 25rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.section-desc {
  font-size: 26rpx;
  color: #999;
}

.price-list {
  border-top: 1rpx solid #f0f0f0;
}

.price-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.price-item:last-child {
  border-bottom: none;
}

.price-header {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.price-name {
  font-size: 30rpx;
}

.level-tag {
  padding: 8rpx 20rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  color: white;
}

.level-tag.bronze {
  background: #d9d9d9;
}

.level-tag.silver {
  background: #faad14;
}

.level-tag.gold {
  background: #ff6b6b;
}

.price-input-wrap {
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 15rpx 20rpx;
}

.price-prefix {
  font-size: 28rpx;
  color: #FF6B6B;
}

.price-input {
  width: 120rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #FF6B6B;
}

.price-input:disabled {
  background: #fafafa;
}

.base-price-info {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 10rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed #f0f0f0;
  margin-top: 10rpx;
}

.info-label {
  font-size: 26rpx;
  color: #999;
}

.info-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #FF6B6B;
}

.status-section {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.status-badge {
  padding: 10rpx 25rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
}

.status-badge.online {
  background: #52c41a;
  color: white;
}

.status-badge.offline {
  background: #d9d9d9;
  color: white;
}

.status-options {
  display: flex;
  gap: 30rpx;
  margin-top: 20rpx;
}

.status-option {
  padding: 15rpx 40rpx;
  background: #f5f5f5;
  border-radius: 25rpx;
  font-size: 28rpx;
}

.status-option.active {
  background: #52c41a;
  color: white;
}

.action-section {
  padding: 20rpx 0;
}

.action-btn {
  width: 100%;
  padding: 25rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.delete-btn {
  background: #ff4d4f;
  color: white;
}

.readonly-banner {
  background: #e6f7ff;
  color: #1890ff;
  padding: 20rpx 30rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  font-size: 28rpx;
}

.people-section,
.review-section {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.people-card,
.review-card,
.review-group {
  margin-top: 16rpx;
}

.people-item,
.participant-item {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 28rpx;
}

.people-label,
.review-title {
  color: #666;
  font-size: 26rpx;
}

.people-value,
.review-content {
  color: #333;
  font-size: 28rpx;
}

.review-empty {
  color: #999;
  font-size: 26rpx;
}

.review-group-title {
  display: block;
  font-weight: bold;
  margin: 20rpx 0 10rpx;
}

.status-badge.completed {
  background: #1890ff;
  color: white;
}

.status-badge.ongoing {
  background: #faad14;
  color: white;
}