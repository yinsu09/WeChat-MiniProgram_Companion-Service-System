.admin-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
}

.header-right {
  display: flex;
  gap: 15rpx;
}

.filter-btn, .add-btn {
  padding: 15rpx 30rpx;
  border-radius: 25rpx;
  font-size: 28rpx;
}

.filter-btn {
  background: rgba(255,255,255,0.2);
}

.add-btn {
  background: white;
  color: #667eea;
}

.filter-panel {
  background: white;
  padding: 20rpx;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
}

.filter-row {
  margin-bottom: 20rpx;
}

.filter-row:last-child {
  margin-bottom: 0;
}

.filter-label {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
}

.filter-options {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.filter-option {
  padding: 15rpx 25rpx;
  background: #f5f5f5;
  border-radius: 25rpx;
  font-size: 26rpx;
}

.filter-option.active {
  background: #667eea;
  color: white;
}

.filter-option.disabled {
  background: #f5f5f5;
  color: #999;
  opacity: 0.6;
}

.filter-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.reset-btn, .confirm-btn {
  flex: 1;
  padding: 20rpx;
  text-align: center;
  border-radius: 25rpx;
  font-size: 28rpx;
}

.reset-btn {
  background: #f5f5f5;
  color: #666;
}

.confirm-btn {
  background: #667eea;
  color: white;
}

.filter-section {
  background: white;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.active-filters {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 15rpx;
}

.filter-tag {
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx;
  background: #f0f5ff;
  color: #667eea;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.filter-tag .close {
  margin-left: 10rpx;
  font-size: 30rpx;
}

.search-box {
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 30rpx;
  padding: 15rpx 20rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 15rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.sort-bar {
  display: flex;
  background: white;
  padding: 20rpx;
  margin-bottom: 20rpx;
  gap: 30rpx;
}

.sort-item {
  font-size: 28rpx;
  color: #666;
}

.sort-item.active {
  color: #667eea;
  font-weight: bold;
}

.sort-icon {
  margin-left: 5rpx;
  font-size: 24rpx;
}

.provider-list {
  padding: 0 20rpx;
}

.provider-card {
  display: flex;
  align-items: center;
  background: white;
  border-radius: 16rpx;
  padding: 25rpx;
  margin-bottom: 20rpx;
}

.provider-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.provider-info {
  flex: 1;
}

.provider-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.provider-name {
  font-size: 32rpx;
  font-weight: bold;
}

.level-badge {
  padding: 8rpx 20rpx;
  border-radius: 15rpx;
  font-size: 22rpx;
  color: white;
}

.provider-phone {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.provider-meta {
  display: flex;
  gap: 20rpx;
  margin-bottom: 10rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #999;
}

.provider-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tag {
  padding: 5rpx 15rpx;
  background: #f0f0f0;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #666;
}

.provider-status {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-left: 20rpx;
  border-left: 1rpx solid #f0f0f0;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-bottom: 10rpx;
}

.status-dot.idle {
  background: #52c41a;
}

.status-dot.busy {
  background: #faad14;
}

.status-dot.offline {
  background: #d9d9d9;
}

.status-dot.disabled {
  background: #ff4d4f;
}

.status-text.disabled-text {
  color: #ff4d4f;
}

.provider-card.is-disabled {
  opacity: 0.75;
  background: #fafafa;
}

.status-text {
  font-size: 24rpx;
  color: #999;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}