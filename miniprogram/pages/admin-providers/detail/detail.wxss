.admin-container {
  min-height: 100vh;
  background: #f5f5f5;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
}

.save-btn, .edit-btn {
  background: rgba(255,255,255,0.2);
  padding: 15rpx 30rpx;
  border-radius: 25rpx;
  font-size: 28rpx;
}

.form-section {
  padding: 20rpx;
}

.form-card {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 30rpx;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  margin-bottom: 20rpx;
}

.upload-btn {
  background: #f0f0f0;
  padding: 15rpx 30rpx;
  border-radius: 25rpx;
  font-size: 26rpx;
}

.form-item {
  margin-bottom: 25rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 15rpx;
}

.form-input {
  width: 100%;
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.form-input:disabled {
  background: #fafafa;
  color: #999;
}

.form-textarea {
  width: 100%;
  height: 150rpx;
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.form-textarea:disabled {
  background: #fafafa;
  color: #999;
}

.form-value {
  font-size: 30rpx;
  color: #333;
}

.gender-options {
  display: flex;
  gap: 30rpx;
}

.gender-option {
  padding: 15rpx 40rpx;
  background: #f5f5f5;
  border-radius: 25rpx;
  font-size: 28rpx;
}

.gender-option.active {
  background: #667eea;
  color: white;
}

.service-type-options {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.type-option {
  padding: 15rpx 25rpx;
  background: #f5f5f5;
  border-radius: 20rpx;
  font-size: 26rpx;
}

.type-option.active {
  background: #667eea;
  color: white;
}

.level-section, .status-section, .stats-section {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
}

.level-badge {
  padding: 8rpx 20rpx;
  border-radius: 10rpx;
  font-size: 24rpx;
  color: white;
}

.status-badge {
  padding: 8rpx 20rpx;
  border-radius: 10rpx;
  font-size: 24rpx;
}

.status-badge.idle {
  background: #52c41a;
  color: white;
}

.status-badge.busy {
  background: #faad14;
  color: white;
}

.status-badge.offline {
  background: #d9d9d9;
  color: white;
}

.status-badge.disabled {
  background: #fff1f0;
  color: #ff4d4f;
}

.level-info {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.level-detail {
  text-align: center;
}

.detail-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.detail-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.level-adjust {
  padding-top: 20rpx;
}

.adjust-label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 15rpx;
}

.level-options {
  display: flex;
  gap: 20rpx;
}

.level-option {
  padding: 15rpx 30rpx;
  background: #f5f5f5;
  border-radius: 25rpx;
  font-size: 28rpx;
}

.level-option.active {
  background: #ff6b6b;
  color: white;
}

.status-options {
  display: flex;
  gap: 20rpx;
}

.status-option {
  padding: 15rpx 30rpx;
  background: #f5f5f5;
  border-radius: 25rpx;
  font-size: 28rpx;
}

.status-option.active {
  background: #52c41a;
  color: white;
}

.stats-grid {
  display: flex;
  justify-content: space-around;
}

.stat-item {
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #667eea;
  margin-bottom: 10rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

.action-section {
  padding: 20rpx 0;
}

.action-btn {
  width: 100%;
  padding: 25rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.delete-btn {
  background: #faad14;
  color: white;
  margin-bottom: 20rpx;
}

.enable-btn {
  background: #52c41a;
  color: white;
  margin-bottom: 20rpx;
}

.remove-btn {
  background: #ff4d4f;
  color: white;
}