.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx 24rpx 140rpx;
}

.hero {
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  border-radius: 16rpx;
  padding: 32rpx;
  color: #fff;
  margin-bottom: 20rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 12rpx;
}

.status {
  font-size: 24rpx;
  background: rgba(255,255,255,0.2);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.label {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 8rpx;
}

.content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.7;
}

.info-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.price {
  color: #FF6B6B;
  font-weight: bold;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 20rpx 24rpx;
}

.join-btn {
  background: #FF6B6B;
  color: #fff;
  text-align: center;
  padding: 24rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: bold;
}

.join-btn.disabled {
  background: #ccc;
}

.loading {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
}
