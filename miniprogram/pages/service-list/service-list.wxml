<view class="container">
  <view class="header">
    <text class="type-icon">{{typeName}}</text>
    <text class="type-count">共{{totalCount}}个服务</text>
  </view>

  <view class="service-list">
    <view wx:if="{{services.length === 0}}" class="empty-tip">
      <text>暂无服务</text>
    </view>
    
    <view 
      wx:for="{{services}}" 
      wx:key="id" 
      class="service-item"
      bindtap="goToServiceDetail"
      data-service-id="{{item.id}}"
    >
      <image class="service-image" src="{{item.cover_image || 'https://via.placeholder.com/150'}}" mode="aspectFill" />
      <view class="service-info">
        <text class="service-name">{{item.name}}</text>
        <text class="service-desc">{{item.description}}</text>
        <view class="service-meta">
          <text class="service-duration">⏱ {{item.duration}}分钟</text>
          <text class="service-orders">🔥 {{item.order_count || 0}}人已购买</text>
        </view>
        <view class="service-price">
          <text class="price">¥{{item.base_price}}</text>
          <text class="price-unit">起</text>
        </view>
      </view>
    </view>
  </view>
</view>
