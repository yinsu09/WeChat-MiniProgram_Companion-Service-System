.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.tab-bar {
  display: flex;
  background: white;
  padding: 0 20rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab text {
  display: inline-block;
  padding: 16rpx 0;
}

.tab.active {
  color: #FF6B6B;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 80rpx;
  height: 4rpx;
  background: #FF6B6B;
  border-radius: 2rpx;
}

.tab-content {
  padding: 20rpx;
}

.review-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.review-card {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
}

.review-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.review-target {
  display: flex;
  align-items: center;
}

.target-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.target-info {
  display: flex;
  flex-direction: column;
}

.target-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 4rpx;
}

.target-level {
  font-size: 22rpx;
  color: #FFB800;
}

.review-rating {
  display: flex;
}

.star {
  font-size: 28rpx;
  color: #ddd;
  margin-left: 4rpx;
}

.star.active {
  color: #FFB800;
}

.review-service {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 12rpx 16rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
}

.service-label {
  font-size: 24rpx;
  color: #666;
}

.service-name {
  font-size: 24rpx;
  color: #333;
  font-weight: 500;
}

.review-ratings-detail {
  display: flex;
  gap: 24rpx;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.rating-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.rating-label {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.rating-stars {
  display: flex;
}

.mini-star {
  font-size: 20rpx;
  color: #ddd;
  margin-right: 2rpx;
}

.mini-star.active {
  color: #FFB800;
}

.review-content {
  font-size: 26rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.review-images {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.review-images image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 8rpx;
}

.review-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.review-time {
  font-size: 22rpx;
  color: #999;
}

.review-anonymous {
  font-size: 22rpx;
  color: #999;
  padding: 4rpx 12rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
}