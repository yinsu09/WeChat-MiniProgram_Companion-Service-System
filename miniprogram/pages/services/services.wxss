.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.header-count {
  font-size: 26rpx;
  color: #999;
}

.assign-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  color: #fff;
}

.assign-title {
  font-size: 32rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 8rpx;
}

.assign-desc {
  font-size: 24rpx;
  opacity: 0.9;
}

.assign-arrow {
  font-size: 48rpx;
  opacity: 0.8;
}

.filter-section {
  background: white;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.filter-item {
  padding: 12rpx 24rpx;
  background: #f5f5f5;
  border-radius: 25rpx;
  font-size: 26rpx;
  color: #666;
}

.filter-item.active {
  background: #FF6B6B;
  color: white;
}

.filter-item.disabled {
  opacity: 0.55;
  color: #999;
  background: #ececec;
}

.filter-item.disabled.active {
  background: #ececec;
  color: #999;
}

.filter-tabs {
  display: flex;
  background: white;
  border-radius: 16rpx;
  padding: 15rpx 20rpx;
  margin-bottom: 20rpx;
}

.filter-tab {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  color: #666;
}

.filter-tab.active {
  color: #FF6B6B;
}

.filter-tab .arrow {
  font-size: 20rpx;
}

.price-filter-popup,
.level-filter-popup,
.sort-filter-popup {
  position: fixed;
  top: 400rpx;
  left: 20rpx;
  right: 20rpx;
  background: white;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.15);
  z-index: 1000;
}

.filter-options {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.filter-option {
  padding: 15rpx 30rpx;
  background: #f5f5f5;
  border-radius: 20rpx;
  font-size: 26rpx;
}

.filter-option.active {
  background: #FF6B6B;
  color: white;
}

.active-filters {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 15rpx;
  background: white;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.filter-label {
  font-size: 26rpx;
  color: #666;
}

.filter-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  flex: 1;
}

.filter-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255,107,107,0.1);
  padding: 8rpx 15rpx;
  border-radius: 15rpx;
  font-size: 24rpx;
  color: #FF6B6B;
}

.tag-close {
  font-size: 28rpx;
  font-weight: bold;
}

.clear-all {
  font-size: 24rpx;
  color: #999;
  padding: 10rpx;
}

.service-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.service-card {
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.card-image {
  width: 100%;
  height: 300rpx;
  object-fit: cover;
}

.card-content {
  padding: 20rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
}

.card-type {
  font-size: 22rpx;
  color: #FF6B6B;
  background: rgba(255,107,107,0.1);
  padding: 5rpx 15rpx;
  border-radius: 10rpx;
  margin-left: 15rpx;
}

.card-desc {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-bottom: 15rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-meta {
  display: flex;
  gap: 30rpx;
  margin-bottom: 15rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.meta-icon {
  font-size: 24rpx;
}

.meta-text {
  font-size: 24rpx;
  color: #666;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.price-box {
  display: flex;
  align-items: baseline;
}

.card-price {
  font-size: 40rpx;
  font-weight: bold;
  color: #FF6B6B;
}

.card-unit {
  font-size: 24rpx;
  color: #999;
  margin-left: 5rpx;
}

.card-btn {
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  color: white;
  padding: 15rpx 35rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #999;
}

.loading-more {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 26rpx;
}