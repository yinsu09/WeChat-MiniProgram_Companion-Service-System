.login-container {
  min-height: 100vh;
  padding: 60rpx 40rpx;
}

.provider-login {
  background: linear-gradient(135deg, #4ECDC4, #44A08D);
}

.logo-section {
  text-align: center;
  padding: 80rpx 0 40rpx;
}

.logo-icon {
  font-size: 120rpx;
  display: block;
  margin-bottom: 15rpx;
}

.logo-title {
  font-size: 44rpx;
  font-weight: bold;
  color: white;
  display: block;
  margin-bottom: 8rpx;
}

.logo-subtitle {
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
}

.role-tag {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-bottom: 40rpx;
}

.role-icon {
  font-size: 32rpx;
}

.role-text {
  font-size: 28rpx;
  color: white;
  background: rgba(255,255,255,0.2);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.login-tabs {
  display: flex;
  background: rgba(255,255,255,0.2);
  border-radius: 10rpx;
  padding: 6rpx;
  margin-bottom: 30rpx;
}

.login-tab {
  flex: 1;
  text-align: center;
  padding: 15rpx;
  font-size: 28rpx;
  color: white;
  border-radius: 8rpx;
  transition: all 0.3s;
}

.login-tab.active {
  background: white;
  color: #4ECDC4;
}

.login-form {
  background: white;
  border-radius: 20rpx;
  padding: 40rpx;
}

.form-item {
  margin-bottom: 25rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 10rpx;
  display: block;
}

.form-input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #eee;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

.password-row {
  position: relative;
}

.forgot-link {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 26rpx;
  color: #4ECDC4;
}

.code-row {
  display: flex;
  gap: 20rpx;
}

.code-input {
  flex: 1;
}

.get-code-btn {
  width: 180rpx;
  height: 80rpx;
  background: #4ECDC4;
  color: white;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
}

.login-btn {
  width: 100%;
  height: 88rpx;
  background: #4ECDC4;
  color: white;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
  margin: 20rpx 0;
}

.register-link {
  text-align: center;
  padding: 15rpx 0;
}

.register-link text {
  font-size: 26rpx;
  color: #999;
}

.other-role {
  margin-top: 40rpx;
  text-align: center;
}

.other-role text:first-child {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
  display: block;
  margin-bottom: 15rpx;
}

.role-btns {
  display: flex;
  justify-content: center;
  gap: 20rpx;
}

.role-btn {
  padding: 15rpx 30rpx;
  border: 2rpx solid rgba(255,255,255,0.5);
  border-radius: 30rpx;
  font-size: 26rpx;
  color: white;
}

.role-btn.admin {
  background: rgba(255,255,255,0.2);
}
