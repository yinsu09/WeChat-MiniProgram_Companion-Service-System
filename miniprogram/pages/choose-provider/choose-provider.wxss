.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx;
  padding-bottom: 40rpx;
}

.page-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.back-btn {
  font-size: 30rpx;
  color: #FF6B6B;
  margin-right: 20rpx;
}

.page-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.type-grid,
.provider-list,
.form-section,
.confirm-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.type-card,
.provider-card,
.confirm-card,
.form-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.type-card.disabled {
  opacity: 0.55;
  background: #f0f0f0;
}

.type-name,
.confirm-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.type-desc,
.step-tip,
.empty-tip {
  font-size: 26rpx;
  color: #666;
}

.form-label {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-bottom: 12rpx;
}

.form-value,
.picker-value {
  font-size: 28rpx;
  color: #333;
}

.form-textarea {
  width: 100%;
  min-height: 180rpx;
  background: #fafafa;
  border-radius: 12rpx;
  padding: 16rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.primary-btn {
  margin-top: 20rpx;
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  color: #fff;
  text-align: center;
  padding: 24rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: bold;
}

.assign-mode-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.assign-mode {
  flex: 1;
  text-align: center;
  padding: 18rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
  font-size: 26rpx;
}

.assign-mode.active {
  background: #fff5f5;
  color: #FF6B6B;
  border: 2rpx solid #FF6B6B;
}

.assign-tip {
  font-size: 24rpx;
  color: #999;
}

.provider-card {
  display: flex;
  align-items: center;
}

.provider-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.provider-info {
  flex: 1;
}

.provider-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.provider-name {
  font-size: 30rpx;
  font-weight: bold;
}

.provider-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  font-size: 24rpx;
  color: #666;
}

.arrow {
  font-size: 36rpx;
  color: #ccc;
}

.detail-link {
  font-size: 24rpx;
  color: #FF6B6B;
  margin-right: 12rpx;
  padding: 8rpx 12rpx;
}

.confirm-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 12rpx 0;
  font-size: 28rpx;
  color: #333;
}

.confirm-row.column {
  flex-direction: column;
}

.requirements-text {
  color: #666;
  line-height: 1.6;
}

.coupon-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 16rpx;
}

.coupon-option,
.selected-coupon {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.coupon-option.disabled {
  opacity: 0.5;
}

.coupon-name {
  font-size: 28rpx;
  font-weight: bold;
  display: block;
}

.coupon-desc {
  font-size: 24rpx;
  color: #999;
}

.coupon-value,
.final-price {
  color: #FF6B6B;
  font-weight: bold;
}

.price-box {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 28rpx;
}

.clear-coupon {
  color: #999;
  margin-left: 16rpx;
}

.empty,
.loading {
  text-align: center;
  color: #999;
  padding: 60rpx 0;
}
