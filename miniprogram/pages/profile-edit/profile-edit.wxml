<view class="container">
  <view class="avatar-section">
    <image class="avatar" src="{{avatarUrl || 'https://via.placeholder.com/150'}}" mode="aspectFill" />
    <view class="avatar-edit" bindtap="changeAvatar">更换头像</view>
  </view>

  <view class="form-section">
    <view class="form-item">
      <text class="label">昵称</text>
      <input class="input" value="{{nickname}}" placeholder="请输入昵称" bindinput="onNicknameInput" />
    </view>
    <view class="form-item">
      <text class="label">姓名</text>
      <input class="input" value="{{realName}}" placeholder="请输入真实姓名" bindinput="onRealNameInput" />
    </view>
    <view class="form-item">
      <text class="label">手机号</text>
      <input class="input" value="{{phone}}" disabled placeholder="手机号" />
    </view>
    <view class="form-item">
      <text class="label">性别</text>
      <radio-group class="gender-group" bindchange="onGenderChange">
        <label class="gender-option"><radio value="1" checked="{{gender === 1}}" color="#FF6B6B" />男</label>
        <label class="gender-option"><radio value="2" checked="{{gender === 2}}" color="#FF6B6B" />女</label>
        <label class="gender-option"><radio value="0" checked="{{gender === 0}}" color="#FF6B6B" />保密</label>
      </radio-group>
    </view>
    <view class="form-item">
      <text class="label">个人简介</text>
      <textarea class="textarea" value="{{bio}}" maxlength="200" placeholder="介绍一下自己" bindinput="onBioInput" />
    </view>
  </view>

  <view class="save-btn" bindtap="saveProfile">保存</view>
</view>
