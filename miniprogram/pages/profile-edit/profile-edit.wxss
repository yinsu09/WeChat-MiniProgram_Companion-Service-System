.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
  background: white;
  margin-bottom: 20rpx;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  margin-bottom: 20rpx;
}

.avatar-edit {
  color: #FF6B6B;
  font-size: 28rpx;
}

.form-section {
  background: white;
  padding: 0 30rpx;
}

.form-item {
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.input, .textarea {
  width: 100%;
  font-size: 30rpx;
  color: #333;
}

.textarea {
  min-height: 120rpx;
}

.gender-group {
  display: flex;
  gap: 40rpx;
}

.gender-option {
  font-size: 28rpx;
  color: #333;
}

.save-btn {
  margin: 40rpx 30rpx 0;
  background: #FF6B6B;
  color: white;
  text-align: center;
  padding: 28rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
}
