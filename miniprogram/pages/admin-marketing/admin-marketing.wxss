.admin-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
}

.overview-section {
  padding: 20rpx;
}

.overview-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.overview-card {
  width: calc(50% - 10rpx);
  display: flex;
  align-items: center;
  background: white;
  border-radius: 16rpx;
  padding: 25rpx;
}

.overview-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.overview-info {
  flex: 1;
}

.overview-value {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #667eea;
}

.overview-label {
  font-size: 24rpx;
  color: #999;
}

.overview-arrow {
  font-size: 40rpx;
  color: #ccc;
}

.stats-section {
  padding: 0 20rpx;
}

.stats-card {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.card-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 25rpx;
}

.stats-grid {
  display: flex;
  justify-content: space-around;
}

.stat-item {
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #FF6B6B;
  margin-bottom: 10rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

.quick-actions {
  padding: 0 20rpx;
  margin-bottom: 20rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.action-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.action-card {
  width: calc(50% - 10rpx);
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-radius: 16rpx;
  padding: 30rpx;
  text-align: center;
  color: white;
}

.action-icon {
  font-size: 48rpx;
  margin-bottom: 15rpx;
}

.action-text {
  font-size: 28rpx;
  font-weight: bold;
}

.active-section {
  padding: 0 20rpx;
}

.active-list {
  display: flex;
  flex-direction: column;
}

.active-card {
  background: white;
  border-radius: 16rpx;
  padding: 25rpx;
  margin-bottom: 15rpx;
}

.active-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.active-tag {
  padding: 8rpx 20rpx;
  background: #667eea;
  color: white;
  border-radius: 15rpx;
  font-size: 24rpx;
}

.active-status {
  font-size: 24rpx;
  color: #52c41a;
}

.active-name {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 15rpx;
}

.active-meta {
  display: flex;
  justify-content: space-between;
  margin-bottom: 15rpx;
}

.meta-item {
  font-size: 26rpx;
  color: #666;
}

.active-progress {
  display: flex;
  align-items: center;
}

.progress-bar {
  flex: 1;
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  margin-right: 15rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #667eea, #764ba2);
  border-radius: 6rpx;
}

.progress-text {
  font-size: 24rpx;
  color: #666;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx;
}

.empty-icon {
  font-size: 60rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.footer {
  text-align: center;
  padding: 30rpx;
}

.copyright {
  font-size: 24rpx;
  color: #999;
}