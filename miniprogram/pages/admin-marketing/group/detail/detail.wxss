.admin-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  background: linear-gradient(135deg, #1890ff, #69c0ff);
  color: white;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
}

.save-btn {
  background: rgba(255,255,255,0.2);
  padding: 15rpx 30rpx;
  border-radius: 25rpx;
  font-size: 28rpx;
}

.readonly-banner {
  margin: 20rpx;
  padding: 20rpx 24rpx;
  background: #fff7e6;
  border: 1rpx solid #ffd591;
  border-radius: 12rpx;
  color: #ad6800;
  font-size: 26rpx;
}

.form-value {
  display: block;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  padding: 10rpx 0;
}

.form-section {
  padding: 20rpx;
}

.form-item {
  background: white;
  border-radius: 16rpx;
  padding: 25rpx;
  margin-bottom: 20rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 15rpx;
}

.form-input {
  width: 100%;
  font-size: 30rpx;
  padding: 15rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-textarea {
  width: 100%;
  height: 150rpx;
  font-size: 28rpx;
  padding: 15rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
}

.date-picker, .time-picker {
  padding: 15rpx 20rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 28rpx;
  margin-bottom: 15rpx;
}

.time-picker:last-child {
  margin-bottom: 0;
}

.duration-input {
  display: flex;
  align-items: center;
}

.duration-field {
  font-size: 48rpx;
  font-weight: bold;
  color: #1890ff;
  width: 150rpx;
}

.duration-unit {
  font-size: 32rpx;
  color: #666;
}

.people-input {
  display: flex;
  align-items: center;
}

.people-field {
  font-size: 32rpx;
  width: 150rpx;
  padding: 15rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  text-align: center;
}

.people-separator {
  margin: 0 20rpx;
  font-size: 28rpx;
  color: #999;
}

.picker-value {
  display: flex;
  align-items: center;
  padding: 15rpx 20rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.picker-arrow {
  margin-left: 20rpx;
  color: #999;
}

.type-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.type-tag {
  padding: 15rpx 25rpx;
  background: #f5f5f5;
  border-radius: 25rpx;
  font-size: 26rpx;
}

.type-tag.selected {
  background: #1890ff;
  color: white;
}

.price-input {
  display: flex;
  align-items: center;
}

.currency {
  font-size: 36rpx;
  color: #1890ff;
  font-weight: bold;
}

.price-field {
  font-size: 48rpx;
  font-weight: bold;
  color: #1890ff;
  width: 200rpx;
}

.action-section {
  padding: 20rpx;
}

.action-btn {
  width: 100%;
  padding: 25rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.action-btn.delete {
  background: #fff1f0;
  color: #ff4d4f;
}

.provider-status {
  margin-bottom: 16rpx;
}

.provider-status-text {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  background: #f5f5f5;
  color: #666;
}

.provider-status-text.pending {
  background: #fff7e6;
  color: #fa8c16;
}

.provider-status-text.accepted {
  background: #f6ffed;
  color: #52c41a;
}

.invite-btn {
  margin-top: 20rpx;
  background: #1890ff;
  color: #fff;
  text-align: center;
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.form-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
}