<view class="admin-container">
  <view class="header">
    <text class="header-title">组团游管理</text>
    <view class="header-right">
      <view class="add-btn" bindtap="goToAdd">+ 添加</view>
    </view>
  </view>

  <view class="filter-section">
    <view class="filter-tabs">
      <view 
        wx:for="{{statusOptions}}" 
        wx:key="value"
        class="filter-tab {{currentStatus === item.value ? 'active' : ''}}"
        bindtap="filterByStatus"
        data-status="{{item.value}}"
      >{{item.label}}</view>
    </view>
  </view>

  <view class="group-list">
    <view 
      wx:for="{{groups}}" 
      wx:key="id" 
      class="group-card"
      bindtap="goToDetail"
      data-id="{{item.id}}"
    >
      <view class="group-info">
        <view class="group-header">
          <text class="group-name">{{item.name}}</text>
          <view class="group-status-badge {{item.status}}">{{getStatusText(item.status)}}</view>
        </view>
        <text class="group-desc">{{item.description}}</text>
        <view class="group-meta">
          <view class="meta-item">
            <text class="meta-icon">📍</text>
            <text>{{item.location}}</text>
          </view>
          <view class="meta-item">
            <text class="meta-icon">📅</text>
            <text>{{item.start_time}}</text>
          </view>
          <view class="meta-item">
            <text class="meta-icon">👤</text>
            <text>{{item.provider_display || '暂无服务人员'}}</text>
          </view>
        </view>
        <view class="group-stats">
          <view class="stat-item">
            <text class="stat-value">{{item.current_people}}</text>
            <text class="stat-label">已报名</text>
          </view>
          <view class="stat-divider"></view>
          <view class="stat-item">
            <text class="stat-value">{{item.max_people}}</text>
            <text class="stat-label">限额</text>
          </view>
          <view class="stat-divider"></view>
          <view class="stat-item">
            <text class="stat-value">¥{{item.price}}</text>
            <text class="stat-label">单价</text>
          </view>
        </view>
        <view class="group-progress">
          <view class="progress-bar">
            <view class="progress-fill" style="width: {{item.progress}}%;" />
          </view>
          <text class="progress-text">{{item.progress}}% 已满</text>
        </view>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:if="{{groups.length === 0}}">
    <text class="empty-icon">🚌</text>
    <text class="empty-text">暂无组团游活动</text>
  </view>
</view>