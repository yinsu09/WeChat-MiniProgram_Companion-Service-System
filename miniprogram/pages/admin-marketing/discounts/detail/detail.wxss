.admin-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  background: linear-gradient(135deg, #ff6b6b, #ff8e8e);
  color: white;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
}

.save-btn {
  background: rgba(255,255,255,0.2);
  padding: 15rpx 30rpx;
  border-radius: 25rpx;
  font-size: 28rpx;
}

.form-section {
  padding: 20rpx;
}

.form-item {
  background: white;
  border-radius: 16rpx;
  padding: 25rpx;
  margin-bottom: 20rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 15rpx;
}

.form-input {
  width: 100%;
  font-size: 30rpx;
  padding: 15rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-textarea {
  width: 100%;
  height: 150rpx;
  font-size: 28rpx;
  padding: 15rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
}

.discount-input {
  display: flex;
  align-items: center;
  padding: 15rpx 0;
}

.discount-field {
  font-size: 48rpx;
  font-weight: bold;
  color: #ff6b6b;
  width: 150rpx;
}

.discount-unit {
  font-size: 32rpx;
  color: #ff6b6b;
  font-weight: bold;
}

.discount-tip {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.time-range, .time-inputs {
  display: flex;
  align-items: center;
  margin-bottom: 15rpx;
}

.time-range:last-child {
  margin-bottom: 0;
}

.date-picker, .time-picker {
  padding: 15rpx 20rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.date-separator, .time-separator {
  margin: 0 20rpx;
  font-size: 28rpx;
  color: #999;
}

.select-all {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.select-all-label {
  font-size: 28rpx;
  margin-left: 15rpx;
}

.service-list {
  max-height: 400rpx;
  overflow-y: auto;
}

.service-item {
  display: flex;
  align-items: center;
  padding: 15rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.service-item.selected {
  background: #fff7f7;
}

.service-name {
  flex: 1;
  font-size: 28rpx;
  margin-left: 15rpx;
}

.service-price {
  font-size: 26rpx;
  color: #ff6b6b;
}

.limit-tip {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.picker-value {
  display: flex;
  align-items: center;
  padding: 15rpx 20rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.picker-arrow {
  margin-left: 20rpx;
  color: #999;
}

.statusOptions {
  padding: 20rpx;
}

.action-section {
  padding: 20rpx;
}

.action-btn {
  width: 100%;
  padding: 25rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.action-btn.delete {
  background: #fff1f0;
  color: #ff4d4f;
}