.admin-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
}

.save-btn {
  background: rgba(255,255,255,0.2);
  padding: 15rpx 30rpx;
  border-radius: 25rpx;
  font-size: 28rpx;
}

.form-section {
  padding: 20rpx;
}

.form-item {
  background: white;
  border-radius: 16rpx;
  padding: 25rpx;
  margin-bottom: 20rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 15rpx;
}

.form-input {
  width: 100%;
  font-size: 30rpx;
  padding: 15rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-textarea {
  width: 100%;
  height: 150rpx;
  font-size: 28rpx;
  padding: 15rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
}

.amount-input {
  display: flex;
  align-items: center;
  padding: 15rpx 0;
}

.currency {
  font-size: 36rpx;
  color: #FF6B6B;
  font-weight: bold;
}

.amount-field {
  font-size: 48rpx;
  font-weight: bold;
  color: #FF6B6B;
  width: 200rpx;
}

.date-range {
  display: flex;
  align-items: center;
}

.date-picker {
  padding: 15rpx 20rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.date-separator {
  margin: 0 20rpx;
  font-size: 28rpx;
  color: #999;
}

.type-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.type-tag {
  padding: 15rpx 25rpx;
  background: #f5f5f5;
  border-radius: 25rpx;
  font-size: 26rpx;
}

.type-tag.selected {
  background: #52c41a;
  color: white;
}

.limit-options {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.limit-item {
  display: flex;
  align-items: center;
}

.limit-label {
  font-size: 28rpx;
  margin-left: 15rpx;
}

.picker-value {
  display: flex;
  align-items: center;
  padding: 15rpx 20rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.picker-arrow {
  margin-left: 20rpx;
  color: #999;
}

.action-section {
  padding: 20rpx;
}

.action-btn {
  width: 100%;
  padding: 25rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.action-btn.delete {
  background: #fff1f0;
  color: #ff4d4f;
}