.admin-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
}

.add-btn {
  background: rgba(255,255,255,0.2);
  padding: 15rpx 30rpx;
  border-radius: 25rpx;
  font-size: 28rpx;
}

.filter-section {
  padding: 20rpx;
  background: white;
}

.filter-tabs {
  display: flex;
  gap: 15rpx;
  margin-bottom: 20rpx;
}

.filter-tab {
  padding: 15rpx 25rpx;
  background: #f5f5f5;
  border-radius: 25rpx;
  font-size: 26rpx;
}

.filter-tab.active {
  background: #667eea;
  color: white;
}

.search-box {
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 30rpx;
  padding: 15rpx 20rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 15rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.coupon-list {
  padding: 20rpx;
}

.coupon-card {
  display: flex;
  background: white;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.coupon-left {
  width: 200rpx;
  background: linear-gradient(135deg, #ff6b6b, #ff8e8e);
  padding: 30rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.coupon-value {
  display: flex;
  align-items: baseline;
}

.currency {
  font-size: 32rpx;
  color: white;
}

.amount {
  font-size: 56rpx;
  font-weight: bold;
  color: white;
}

.coupon-condition {
  font-size: 22rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 10rpx;
}

.coupon-right {
  flex: 1;
  padding: 25rpx;
}

.coupon-name {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.coupon-desc {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 15rpx;
}

.coupon-meta {
  display: flex;
  justify-content: space-between;
  margin-bottom: 15rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #999;
}

.coupon-status {
  display: flex;
  justify-content: flex-end;
}

.status-badge {
  padding: 8rpx 20rpx;
  border-radius: 15rpx;
  font-size: 24rpx;
}

.status-badge.active {
  background: #f6ffed;
  color: #52c41a;
}

.status-badge.inactive {
  background: #f5f5f5;
  color: #999;
}

.status-badge.expired {
  background: #fff1f0;
  color: #ff4d4f;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}