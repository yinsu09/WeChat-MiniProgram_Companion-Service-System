.admin-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
}

.export-btn {
  background: rgba(255,255,255,0.2);
  padding: 15rpx 30rpx;
  border-radius: 25rpx;
  font-size: 28rpx;
}

.filter-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: white;
}

.date-picker {
  padding: 15rpx 20rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.date-separator {
  font-size: 28rpx;
  color: #999;
}

.refresh-btn {
  font-size: 36rpx;
}

.overview-section {
  padding: 20rpx;
}

.overview-grid {
  display: flex;
  gap: 15rpx;
}

.overview-card {
  flex: 1;
  background: white;
  border-radius: 16rpx;
  padding: 25rpx;
  text-align: center;
}

.overview-value {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #667eea;
  margin-bottom: 10rpx;
}

.overview-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.overview-trend {
  font-size: 22rpx;
  padding: 5rpx 15rpx;
  border-radius: 15rpx;
}

.overview-trend.up {
  background: #f6ffed;
  color: #52c41a;
}

.overview-trend.down {
  background: #fff7e6;
  color: #faad14;
}

.tabs-section {
  padding: 0 20rpx;
}

.tabs {
  display: flex;
  background: white;
  border-radius: 16rpx;
  padding: 10rpx;
}

.tab {
  flex: 1;
  padding: 20rpx;
  text-align: center;
  font-size: 26rpx;
  border-radius: 12rpx;
}

.tab.active {
  background: #667eea;
  color: white;
}

.content-section {
  padding: 20rpx;
}

.section-card {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-header {
  margin-bottom: 25rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
}

.chart-container {
  margin-bottom: 30rpx;
}

.chart-bars {
  display: flex;
  justify-content: space-around;
  align-items: flex-end;
  height: 300rpx;
  padding: 20rpx 0;
}

.bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.bar-wrapper {
  height: 250rpx;
  width: 60rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  display: flex;
  align-items: flex-end;
}

.bar {
  width: 100%;
  background: linear-gradient(180deg, #667eea, #764ba2);
  border-radius: 8rpx;
  position: relative;
  transition: height 0.3s;
}

.bar-value {
  position: absolute;
  top: -40rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 22rpx;
  color: #667eea;
  white-space: nowrap;
}

.bar-label {
  margin-top: 15rpx;
  font-size: 24rpx;
  color: #666;
  text-align: center;
}

.table-section {
  overflow-x: auto;
}

.table-header {
  display: flex;
  padding: 15rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}

.th {
  flex: 1;
  font-size: 26rpx;
  font-weight: bold;
  color: #666;
  text-align: center;
}

.table-row {
  display: flex;
  padding: 15rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.td {
  flex: 1;
  font-size: 26rpx;
  color: #333;
  text-align: center;
}

.ranking-list {
  display: flex;
  flex-direction: column;
}

.ranking-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.ranking-item:last-child {
  border-bottom: none;
}

.rank-badge {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: white;
  margin-right: 20rpx;
}

.service-image, .provider-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
}

.provider-avatar {
  border-radius: 50%;
}

.service-info, .provider-info {
  flex: 1;
}

.service-name, .provider-name {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.service-type {
  font-size: 24rpx;
  color: #999;
}

.level-badge {
  display: inline-block;
  padding: 5rpx 15rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: white;
}

.service-stats, .provider-stats {
  text-align: right;
}

.stat-item {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 5rpx;
}

.stats-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.stat-card {
  width: calc(50% - 10rpx);
  background: #f9f9f9;
  border-radius: 12rpx;
  padding: 25rpx;
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #667eea;
  margin-bottom: 10rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

.chart-section {
  margin-top: 30rpx;
}

.chart-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.pie-chart {
  display: flex;
  justify-content: space-around;
  padding: 20rpx;
}

.pie-slice {
  text-align: center;
}

.slice-label {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-top: 10rpx;
}

.refund-chart {
  margin-bottom: 30rpx;
}

.refund-bar-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.refund-label {
  width: 180rpx;
  font-size: 26rpx;
  color: #666;
}

.refund-bar-wrapper {
  flex: 1;
  height: 30rpx;
  background: #f5f5f5;
  border-radius: 15rpx;
  margin: 0 20rpx;
}

.refund-bar {
  height: 100%;
  background: linear-gradient(90deg, #ff4d4f, #ff7875);
  border-radius: 15rpx;
}

.refund-value {
  width: 120rpx;
  font-size: 26rpx;
  color: #333;
  text-align: right;
}

.refund-summary {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.summary-item {
  width: calc(50% - 10rpx);
  display: flex;
  justify-content: space-between;
  padding: 15rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
}

.summary-label {
  font-size: 26rpx;
  color: #666;
}

.summary-value {
  font-size: 26rpx;
  font-weight: bold;
  color: #ff4d4f;
}

.trend-chart {
  margin-bottom: 30rpx;
}

.trend-header {
  display: flex;
  padding: 15rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}

.trend-label {
  flex: 1;
  font-size: 26rpx;
  font-weight: bold;
  color: #666;
  text-align: center;
}

.trend-row {
  display: flex;
  align-items: center;
  padding: 15rpx 0;
}

.trend-date {
  width: 100rpx;
  font-size: 24rpx;
  color: #999;
}

.trend-bars {
  flex: 1;
  height: 80rpx;
  display: flex;
  justify-content: center;
  gap: 15rpx;
  align-items: flex-end;
}

.trend-bar {
  width: 40rpx;
  border-radius: 8rpx;
}

.trend-bar.bronze {
  background: #d9d9d9;
}

.trend-bar.silver {
  background: #faad14;
}

.trend-bar.gold {
  background: #ff6b6b;
}

.trend-values {
  width: 150rpx;
  display: flex;
  justify-content: space-around;
}

.trend-value {
  font-size: 22rpx;
  color: #666;
}

.level-summary {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.level-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
}

.level-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  margin-right: 15rpx;
}

.level-dot.bronze {
  background: #d9d9d9;
}

.level-dot.silver {
  background: #faad14;
}

.level-dot.gold {
  background: #ff6b6b;
}

.level-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.level-count {
  font-size: 28rpx;
  font-weight: bold;
  margin-right: 20rpx;
}

.level-change {
  font-size: 26rpx;
  color: #52c41a;
}

.footer {
  text-align: center;
  padding: 30rpx;
}

.copyright {
  font-size: 24rpx;
  color: #999;
}