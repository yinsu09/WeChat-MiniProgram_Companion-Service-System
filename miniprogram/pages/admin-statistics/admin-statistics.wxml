<view class="admin-container">
  <view class="header">
    <text class="header-title">数据统计</text>
    <view class="header-right">
      <view class="export-btn" bindtap="exportReport">导出报表</view>
    </view>
  </view>

  <view class="filter-bar">
    <picker mode="date" value="{{startDate}}" start="2024-01-01" end="{{today}}" bindchange="onStartDateChange">
      <view class="date-picker">{{startDate}}</view>
    </picker>
    <text class="date-separator">至</text>
    <picker mode="date" value="{{endDate}}" start="2024-01-01" end="{{today}}" bindchange="onEndDateChange">
      <view class="date-picker">{{endDate}}</view>
    </picker>
    <view class="refresh-btn" bindtap="refreshData">🔄</view>
  </view>

  <view class="overview-section">
    <view class="overview-grid">
      <view class="overview-card">
        <text class="overview-value">¥{{stats.totalRevenueText || stats.totalRevenue || '0.00'}}</text>
        <text class="overview-label">总营收</text>
        <view class="overview-trend up">↑ {{stats.revenueGrowth}}%</view>
      </view>
      <view class="overview-card">
        <text class="overview-value">{{stats.totalOrders}}</text>
        <text class="overview-label">总订单</text>
        <view class="overview-trend up">↑ {{stats.orderGrowth}}%</view>
      </view>
      <view class="overview-card">
        <text class="overview-value">{{stats.totalUsers}}</text>
        <text class="overview-label">新增用户</text>
        <view class="overview-trend up">↑ {{stats.userGrowth}}%</view>
      </view>
      <view class="overview-card">
        <text class="overview-value">{{stats.refundRate}}%</text>
        <text class="overview-label">退款率</text>
        <view class="overview-trend down">↓ {{stats.refundRateChange}}%</view>
      </view>
    </view>
  </view>

  <view class="tabs-section">
    <view class="tabs">
      <view 
        wx:for="{{tabOptions}}" 
        wx:key="key"
        class="tab {{currentTab === item.key ? 'active' : ''}}"
        bindtap="switchTab"
        data-tab="{{item.key}}"
      >{{item.label}}</view>
    </view>
  </view>

  <view class="content-section" wx:if="{{currentTab === 'sales'}}">
    <view class="section-card">
      <view class="section-header">
        <text class="section-title">服务销售统计</text>
      </view>
      <view class="chart-container">
        <view class="chart-bars">
          <view 
            wx:for="{{salesData}}" 
            wx:key="type"
            class="bar-item"
          >
            <view class="bar-wrapper">
              <view class="bar" style="height: {{item.percentage}}%;">
                <view class="bar-value">¥{{item.amount}}</view>
              </view>
            </view>
            <text class="bar-label">{{item.type}}</text>
          </view>
        </view>
      </view>
      <view class="table-section">
        <view class="table-header">
          <text class="th">服务类型</text>
          <text class="th">订单数</text>
          <text class="th">销售额</text>
          <text class="th">占比</text>
        </view>
        <view class="table-row" wx:for="{{salesData}}" wx:key="type">
          <text class="td">{{item.type}}</text>
          <text class="td">{{item.count}}</text>
          <text class="td">¥{{item.amount}}</text>
          <text class="td">{{item.percentage}}%</text>
        </view>
      </view>
    </view>
  </view>

  <view class="content-section" wx:if="{{currentTab === 'hot'}}">
    <view class="section-card">
      <view class="section-header">
        <text class="section-title">热门服务 Top10</text>
      </view>
      <view class="ranking-list">
        <view 
          wx:for="{{hotServices}}" 
          wx:key="id"
          class="ranking-item"
        >
          <view class="rank-badge" style="background: {{item.rankColor || '#999'}}">{{item.rank}}</view>
          <image class="service-image" src="{{item.image}}" />
          <view class="service-info">
            <text class="service-name">{{item.name}}</text>
            <text class="service-type">{{item.type}}</text>
          </view>
          <view class="service-stats">
            <text class="stat-item">订单: {{item.orders}}</text>
            <text class="stat-item">收入: ¥{{item.revenue}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="section-card">
      <view class="section-header">
        <text class="section-title">热门服务人员 Top10</text>
      </view>
      <view class="ranking-list">
        <view 
          wx:for="{{hotProviders}}" 
          wx:key="id"
          class="ranking-item"
        >
          <view class="rank-badge" style="background: {{item.rankColor || '#999'}}">{{item.rank}}</view>
          <image class="provider-avatar" src="{{item.avatar}}" />
          <view class="provider-info">
            <text class="provider-name">{{item.name}}</text>
            <view class="level-badge" style="background: {{item.levelColor || '#d9d9d9'}}">{{item.levelName}}</view>
          </view>
          <view class="provider-stats">
            <text class="stat-item">服务: {{item.services}}次</text>
            <text class="stat-item">评分: {{item.rating}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="content-section" wx:if="{{currentTab === 'user'}}">
    <view class="section-card">
      <view class="section-header">
        <text class="section-title">用户消费行为分析</text>
      </view>
      <view class="stats-grid">
        <view class="stat-card">
          <text class="stat-value">{{userStats.averageOrder}}</text>
          <text class="stat-label">平均订单金额</text>
        </view>
        <view class="stat-card">
          <text class="stat-value">{{userStats.repeatRate}}%</text>
          <text class="stat-label">复购率</text>
        </view>
        <view class="stat-card">
          <text class="stat-value">{{userStats.activeUsers}}</text>
          <text class="stat-label">活跃用户</text>
        </view>
        <view class="stat-card">
          <text class="stat-value">{{userStats.newUsers}}</text>
          <text class="stat-label">新用户</text>
        </view>
      </view>
      <view class="chart-section">
        <text class="chart-title">用户消费等级分布</text>
        <view class="pie-chart">
          <view class="pie-slice" style="--percentage: {{userStats.levelDistribution.gold}}; --color: #ff6b6b;">
            <text class="slice-label">金牌用户 {{userStats.levelDistribution.gold}}%</text>
          </view>
          <view class="pie-slice" style="--percentage: {{userStats.levelDistribution.silver}}; --color: #faad14;">
            <text class="slice-label">银牌用户 {{userStats.levelDistribution.silver}}%</text>
          </view>
          <view class="pie-slice" style="--percentage: {{userStats.levelDistribution.bronze}}; --color: #d9d9d9;">
            <text class="slice-label">铜牌用户 {{userStats.levelDistribution.bronze}}%</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="content-section" wx:if="{{currentTab === 'refund'}}">
    <view class="section-card">
      <view class="section-header">
        <text class="section-title">退费原因统计分析</text>
      </view>
      <view class="refund-chart">
        <view 
          wx:for="{{refundReasons}}" 
          wx:key="reason"
          class="refund-bar-item"
        >
          <text class="refund-label">{{item.reason}}</text>
          <view class="refund-bar-wrapper">
            <view class="refund-bar" style="width: {{item.percentage}}%;" />
          </view>
          <text class="refund-value">{{item.count}}次 ({{item.percentage}}%)</text>
        </view>
      </view>
      <view class="refund-summary">
        <view class="summary-item">
          <text class="summary-label">总退款次数</text>
          <text class="summary-value">{{refundStats.totalRefunds}}</text>
        </view>
        <view class="summary-item">
          <text class="summary-label">退款金额</text>
          <text class="summary-value">¥{{refundStats.totalAmount}}</text>
        </view>
        <view class="summary-item">
          <text class="summary-label">平均退款金额</text>
          <text class="summary-value">¥{{refundStats.averageAmount}}</text>
        </view>
        <view class="summary-item">
          <text class="summary-label">退款成功率</text>
          <text class="summary-value">{{refundStats.successRate}}%</text>
        </view>
      </view>
    </view>
  </view>

  <view class="content-section" wx:if="{{currentTab === 'trend'}}">
    <view class="section-card">
      <view class="section-header">
        <text class="section-title">服务人员分级变化趋势</text>
      </view>
      <view class="trend-chart">
        <view class="trend-header">
          <text class="trend-label">时间</text>
          <text class="trend-label">铜牌</text>
          <text class="trend-label">银牌</text>
          <text class="trend-label">金牌</text>
        </view>
        <view class="trend-body">
          <view wx:for="{{levelTrend}}" wx:key="date" class="trend-row">
            <text class="trend-date">{{item.date}}</text>
            <view class="trend-bars">
              <view class="trend-bar bronze" style="height: {{item.bronzeHeight}}%;" />
              <view class="trend-bar silver" style="height: {{item.silverHeight}}%;" />
              <view class="trend-bar gold" style="height: {{item.goldHeight}}%;" />
            </view>
            <view class="trend-values">
              <text class="trend-value">{{item.bronze}}</text>
              <text class="trend-value">{{item.silver}}</text>
              <text class="trend-value">{{item.gold}}</text>
            </view>
          </view>
        </view>
      </view>
      <view class="level-summary">
        <view class="level-item">
          <view class="level-dot bronze"></view>
          <text class="level-name">铜牌服务人员</text>
          <text class="level-count">{{levelStats.bronze}}人</text>
          <text class="level-change">{{levelStats.bronzeChange > 0 ? '+' : ''}}{{levelStats.bronzeChange}}</text>
        </view>
        <view class="level-item">
          <view class="level-dot silver"></view>
          <text class="level-name">银牌服务人员</text>
          <text class="level-count">{{levelStats.silver}}人</text>
          <text class="level-change">{{levelStats.silverChange > 0 ? '+' : ''}}{{levelStats.silverChange}}</text>
        </view>
        <view class="level-item">
          <view class="level-dot gold"></view>
          <text class="level-name">金牌服务人员</text>
          <text class="level-count">{{levelStats.gold}}人</text>
          <text class="level-change">{{levelStats.goldChange > 0 ? '+' : ''}}{{levelStats.goldChange}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="footer">
    <text class="copyright">数据统计 © 2024</text>
  </view>
</view>