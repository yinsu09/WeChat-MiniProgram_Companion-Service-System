.login-container {
  min-height: 100vh;
  padding: 60rpx 40rpx;
}

.admin-login {
  background: linear-gradient(135deg, #667eea, #764ba2);
}

.logo-section {
  text-align: center;
  padding: 80rpx 0 40rpx;
}

.logo-icon {
  font-size: 120rpx;
  display: block;
  margin-bottom: 15rpx;
}

.logo-title {
  font-size: 44rpx;
  font-weight: bold;
  color: white;
  display: block;
  margin-bottom: 8rpx;
}

.logo-subtitle {
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
}

.role-tag {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-bottom: 40rpx;
}

.role-icon {
  font-size: 32rpx;
}

.role-text {
  font-size: 28rpx;
  color: white;
  background: rgba(255,255,255,0.2);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.login-form {
  background: white;
  border-radius: 20rpx;
  padding: 40rpx;
}

.form-item {
  margin-bottom: 25rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 10rpx;
  display: block;
}

.form-input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #eee;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

.remember-me {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #ccc;
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 10rpx;
}

.checkbox.selected {
  background: #667eea;
  border-color: #667eea;
}

.checkbox-icon {
  font-size: 24rpx;
  color: white;
}

.remember-text {
  font-size: 26rpx;
  color: #666;
}

.login-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
  margin: 20rpx 0;
}

.other-role {
  margin-top: 40rpx;
  text-align: center;
}

.other-role text:first-child {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
  display: block;
  margin-bottom: 15rpx;
}

.role-btns {
  display: flex;
  justify-content: center;
  gap: 20rpx;
}

.role-btn {
  padding: 15rpx 30rpx;
  border: 2rpx solid rgba(255,255,255,0.5);
  border-radius: 30rpx;
  font-size: 26rpx;
  color: white;
}

.role-btn.provider {
  background: rgba(255,255,255,0.2);
}
