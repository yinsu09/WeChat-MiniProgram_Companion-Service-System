.container {
  padding: 30rpx;
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 160rpx;
}

.form-item {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
}

.form-row {
  display: flex;
  gap: 20rpx;
}

.form-item.half {
  flex: 1;
}

.label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
  display: block;
}

.input {
  font-size: 32rpx;
  color: #333;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eee;
}

.price-input {
  display: flex;
  align-items: center;
}

.currency {
  font-size: 32rpx;
  color: #ff6b6b;
  margin-right: 8rpx;
}

.price-hint {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.textarea {
  font-size: 32rpx;
  color: #333;
  padding: 16rpx;
  border: 1rpx solid #eee;
  border-radius: 8rpx;
  min-height: 120rpx;
}

.picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eee;
  font-size: 32rpx;
  color: #333;
}

.arrow {
  font-size: 24rpx;
  color: #999;
  transform: rotate(90deg);
}

.checkbox-group {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 16rpx;
}

.checkbox-item {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #f8f8f8;
  border-radius: 8rpx;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #ddd;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  font-size: 24rpx;
  color: #fff;
}

.checkbox.checked {
  background: #ff6b6b;
  border-color: #ff6b6b;
}

.submit-btn {
  position: fixed;
  bottom: 30rpx;
  left: 30rpx;
  right: 30rpx;
  background: #ff6b6b;
  color: #fff;
  padding: 28rpx;
  border-radius: 40rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
}

.submit-btn:active {
  opacity: 0.8;
}

.image-section {
  display: flex;
  gap: 20rpx;
}

.cover-box {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f8f8f8;
}

.cover-image, .extra-image {
  width: 100%;
  height: 100%;
}

.cover-placeholder, .extra-add {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 26rpx;
  border: 1rpx dashed #ddd;
  border-radius: 12rpx;
}

.extra-images {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.extra-item {
  position: relative;
  width: 120rpx;
  height: 120rpx;
}

.extra-add {
  width: 120rpx;
  height: 120rpx;
}

.remove-btn {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 36rpx;
  height: 36rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  border-radius: 50%;
  text-align: center;
  line-height: 36rpx;
  font-size: 24rpx;
}

.card-type-group {
  display: flex;
  gap: 20rpx;
}

.card-type-item {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #666;
}

.card-type-item.active {
  background: #fff0f0;
  color: #ff6b6b;
  border: 1rpx solid #ff6b6b;
}
